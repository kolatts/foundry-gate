@page "/"
@inject NavigationManager Navigation

@* The front door. Anonymous visitors get the sign-in pitch; anyone signed in is sent straight to
   the page they came for — /dashboard for an admin, /me for a developer — rather than a summary
   that only duplicates half of /me. *@

<PageTitle>Foundry Gate</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center ga-4" Style="min-height: 40vh;">
            <MudProgressCircular Indeterminate="true" data-testid="home-redirecting" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Taking you to your account&#8230;</MudText>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center ga-4" Style="min-height: 60vh; text-align: center;">
            <MudText Typo="Typo.h3" HtmlTag="h1">Foundry Gate</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                Give every developer their own AI budget. Sign in with your organization
                account to see your quota, your API key, and your request history.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="authentication/login">Sign in</MudButton>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        // replace: true so the browser's Back button leaves the app rather than bouncing the user
        // through this redirect again.
        Navigation.NavigateTo(
            authState.User.IsInRole(RoleNames.Admin) ? "dashboard" : "me",
            forceLoad: false,
            replace: true);
    }
}
