@page "/"
@using FoundryGate.Domain.Users.Contracts
@inject IFoundryGateApiClient ApiClient

<PageTitle>Foundry Gate</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <MudText Typo="Typo.h4" Class="mb-4">
            Hello, @(_profile?.DisplayName ?? authContext.User.FindFirst("name")?.Value ?? authContext.User.Identity?.Name ?? "there")
        </MudText>

        <MudCard Elevation="2" Style="max-width: 420px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="fg-label mb-2">This month's usage</MudText>

                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_profile is not null)
                {
                    @if (_profile.Quota.IsUnlimited)
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.AllInclusive">Unlimited</MudChip>
                    }
                    else
                    {
                        <MudProgressLinear Color="@GaugeColor(_profile.Quota.PercentUsed)" Value="@(_profile.Quota.PercentUsed ?? 0)" Class="my-2" Rounded="true" Size="Size.Large" />
                        <MudText Typo="Typo.body2" Class="fg-mono">
                            @_profile.Quota.TokensUsed.ToString("N0") / @(_profile.Quota.AllocatedTokens?.ToString("N0") ?? "—") tokens
                        </MudText>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.CloudOff">@_statusMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center ga-4" Style="min-height: 60vh; text-align: center;">
            <MudText Typo="Typo.h3">Foundry Gate</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                Give every developer their own AI budget. Sign in with your organization
                account to see your quota, your API key, and your request history.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="authentication/login">Sign in</MudButton>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private UserProfileResponse? _profile;
    private bool _loading = true;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            // Anonymous visitors see the landing page above and never need the API call.
            _loading = false;
            return;
        }

        // The API doesn't exist yet at the time this shell ships (#48 scaffold-only) — a
        // 401/404/unreachable result here is expected, not exceptional, and must render a
        // friendly message rather than crash the shell.
        var result = await ApiClient.GetMeAsync();
        _loading = false;
        if (result.IsSuccess)
        {
            _profile = result.Value;
        }
        else
        {
            _statusMessage = result.Message ?? "Foundry Gate's API isn't available right now.";
        }
    }

    private static Color GaugeColor(double? percentUsed) => percentUsed switch
    {
        >= 100 => Color.Error,
        >= 80 => Color.Warning,
        _ => Color.Success,
    };
}
