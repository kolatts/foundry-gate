@page "/users/sync"
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IFoundryGateApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sync Entra Users — Foundry Gate</PageTitle>

@if (_accessDenied)
{
    <AccessDenied />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="users" Class="mb-2">All users</MudButton>
    <MudText Typo="Typo.h4" Class="mb-2">Sync users from Entra</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6" Style="max-width: 44rem;">
        Reconciles the user list against the people assigned to the Foundry Gate application in
        Entra — both those assigned directly and those assigned through a group, which is expanded
        to its members. New assignees are added without a key, existing people have their name,
        email and employee id refreshed, and people no longer assigned are deprovisioned: gateway
        key deleted, account deactivated. Nothing is ever deleted, and nobody is re-activated
        automatically. Running it twice does nothing the second time.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Sync"
               Disabled="@_running"
               OnClick="@RunAsync"
               data-testid="run-sync">
        @(_running ? "Syncing…" : "Run Entra sync")
    </MudButton>

    @if (_running)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" Style="max-width: 44rem;" data-testid="sync-progress" />
    }

    @if (_result is { } result)
    {
        <MudAlert Severity="@ResultSeverity(result)"
                  Class="mt-6"
                  Style="max-width: 44rem;"
                  data-testid="sync-result">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Sync finished</MudText>
            <ul class="ml-4">
                <li data-testid="sync-added">@result.AddedCount added</li>
                <li data-testid="sync-updated">@result.UpdatedCount updated</li>
                <li data-testid="sync-deactivated">@result.DeactivatedCount deactivated</li>
                <li data-testid="sync-skipped">@result.SkippedGroupAssignmentCount group assignments could not be expanded</li>
                <li data-testid="sync-failed">@result.FailedCount departures failed</li>
            </ul>
        </MudAlert>

        @if (result.FailedCount > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Style="max-width: 44rem;" data-testid="sync-failed-explainer">
                <MudText Typo="Typo.subtitle2" Class="mb-1">@result.FailedCount departure(s) still hold a working key</MudText>
                The gateway refused to delete their APIM subscription, so those people were left as
                they were — everyone else was still processed. Deprovisioning is idempotent, so run
                the sync again; if it keeps failing, the gateway is the thing to look at.
            </MudAlert>
        }

        @if (result.SkippedGroupAssignmentCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Style="max-width: 44rem;" data-testid="sync-skipped-explainer">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Nobody was deactivated on this run</MudText>
                @result.SkippedGroupAssignmentCount group assignment(s) could not be expanded to their
                members — Graph refused the read (usually a missing <code>GroupMember.ReadBasic.All</code>
                on the API's managed identity), the group has been deleted, or Graph was briefly
                unreachable. That means this run saw only part of the population, so "not in the list"
                can't mean "has left" and departure detection was switched off for it; people were
                still added and updated. The offending groups are named in the API log and in this
                run's audit row. Grant the role (or unassign the deleted group) and run it again — on
                a healthy tenant this count is always zero. See
                <MudLink Href="https://github.com/kolatts/foundry-gate/issues/120" Target="_blank">#120</MudLink>
                for the live-tenant checklist and
                <MudLink Href="https://github.com/kolatts/foundry-gate/issues/183" Target="_blank">#183</MudLink>
                for the Graph paging caveat.
            </MudAlert>
        }
    }

    <MudAlert Severity="Severity.Normal" Class="mt-6" Style="max-width: 44rem;" data-testid="sync-history-note">
        @if (_lastSync is { LastSyncDate: { } lastSyncDate })
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">
                Last run @lastSyncDate.ToLocalTime().ToString("d MMM yyyy HH:mm")
            </MudText>
            <span data-testid="sync-last-summary">
                @(_lastSync.LastResult is { } last
                    ? $"{last.AddedCount} added, {last.UpdatedCount} updated, {last.DeactivatedCount} deactivated, {last.FailedCount} failed."
                    : "The counts from that run weren't recorded.")
            </span>
        }
        else
        {
            <span data-testid="sync-last-summary">This fork has no record of a previous sync.</span>
        }
        <MudText Typo="Typo.caption" Class="d-block mt-2">
            Only the most recent run is kept. Every run writes an audit row, so
            <MudLink Href="@($"audit?action={AuditActions.UsersSynced}")">the audit log</MudLink> has the
            full history.
        </MudText>
    </MudAlert>
}

@code {
    private UserSyncResult? _result;
    private UserSyncStatusResponse? _lastSync;
    private bool _running;
    private bool _accessDenied;

    /// <summary>
    /// The previous run, from <c>GET /users/sync/last</c> (#171). A failure here is deliberately
    /// silent: the page's job is running a sync, and "we couldn't tell you about last time" is not
    /// worth a red banner over the button that matters.
    /// </summary>
    protected override Task OnInitializedAsync() => LoadLastSyncAsync();

    private async Task LoadLastSyncAsync()
    {
        var result = await Api.GetLastUserSyncAsync();
        if (result.IsSuccess)
        {
            _lastSync = result.Value;
        }
    }

    /// <summary>
    /// A run that left someone holding a key is an error, not a success; one that suspended
    /// departure detection is a warning. Both still added and updated everyone they could.
    /// </summary>
    private static Severity ResultSeverity(UserSyncResult result) => result switch
    {
        { FailedCount: > 0 } => Severity.Error,
        { SkippedGroupAssignmentCount: > 0 } => Severity.Warning,
        _ => Severity.Success,
    };

    private async Task RunAsync()
    {
        // The only unconfirmed button in the admin surface used to be this one — and it is the one
        // that deactivates accounts and deletes APIM subscriptions in bulk.
        var confirmed = await DialogService.ConfirmAsync(
            title: "Run Entra sync",
            message: "Reconcile every user against Entra now?",
            detail: "People no longer assigned to the application are deprovisioned: gateway key deleted, account deactivated, this month's allocation hard-stopped, pending requests rejected. New assignees are added and existing ones refreshed.",
            confirmText: "Run sync",
            confirmColor: Color.Warning);

        if (!confirmed)
        {
            return;
        }

        _running = true;
        try
        {
            var result = await Api.SyncUsersAsync();

            if (result.Status == ApiCallStatus.Forbidden)
            {
                _accessDenied = true;
                return;
            }

            if (!result.IsSuccess || result.Value is null)
            {
                Snackbar.Add(result.Message ?? "The Entra sync didn't run.", Severity.Error);
                return;
            }

            _result = result.Value;
            Snackbar.Add("Entra sync finished.", Severity.Success);

            // Re-read rather than assuming: the stored record is what a reload would show, and if the
            // run somehow didn't write one, the page should say so rather than invent it.
            await LoadLastSyncAsync();
        }
        finally
        {
            _running = false;
        }
    }
}
