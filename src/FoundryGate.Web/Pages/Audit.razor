@page "/audit"
@attribute [Authorize(Roles = RoleNames.Admin)]
@using System.Globalization
@using FoundryGate.Domain.Audit.Contracts
@using FoundryGate.Domain.Common
@inject IFoundryGateApiClient ApiClient
@inject ISnackbar Snackbar
@inject TimeProvider TimeProvider

@* The audit trail (#55). Server-paged and server-filtered: the log is append-only and unbounded,
   so nothing here ever holds more than one page. The action and target-type choices come from the
   Domain constants the writers use, not from a list retyped in the UI. *@

<PageTitle>Audit Log — Foundry Gate</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Audit log</MudText>

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Label="Action"
                           Value="@_action"
                           ValueChanged="@(value => ApplyFilterAsync(() => _action = value))"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           data-testid="audit-filter-action">
                    @foreach (var action in Actions)
                    {
                        <MudSelectItem T="string" Value="@action">@action</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Label="Target type"
                           Value="@_targetType"
                           ValueChanged="@(value => ApplyFilterAsync(() => _targetType = value))"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           data-testid="audit-filter-target-type">
                    @foreach (var targetType in TargetTypes)
                    {
                        <MudSelectItem T="string" Value="@targetType">@targetType</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudDateRangePicker Label="Occurred between"
                                    DateRange="@_dateRange"
                                    DateRangeChanged="@(range => ApplyFilterAsync(() => _dateRange = range))"
                                    Clearable="true"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    data-testid="audit-filter-dates" />
            </MudItem>

            <MudItem xs="12" md="2">
                @* An admin reading the log knows "Ada Lovelace", not "user 41" (#191). Typing a bare
                   id still works: the search falls back to GET /users/{id} when the term is numeric
                   and the name search has nothing for it, which is also how a ?actor= deep link
                   recovers the name to show in the box. *@
                <MudAutocomplete T="UserResponse"
                                 Label="Actor"
                                 Value="@_actor"
                                 ValueChanged="@OnActorChangedAsync"
                                 SearchFunc="@SearchActorsAsync"
                                 ToStringFunc="@ActorLabel"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="true"
                                 Clearable="true"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HelperText="Name, email, or a user id"
                                 data-testid="audit-filter-actor" />
            </MudItem>
        </MudGrid>

        @if (HasFilters)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                       Class="mt-2"
                       OnClick="ClearFiltersAsync"
                       data-testid="audit-filter-clear">
                Clear filters
            </MudButton>
        }
    </MudCardContent>
</MudCard>

<MudDataGrid @ref="_grid"
             T="AuditLogEntryResponse"
             ServerData="LoadAsync"
             Dense="true"
             Hover="true"
             Elevation="2"
             RowsPerPage="@PageSize"
             data-testid="audit-grid">
    <Columns>
        <HierarchyColumn T="AuditLogEntryResponse" />
        <TemplateColumn Title="Occurred" Sortable="false">
            <CellTemplate Context="cell">@cell.Item.OccurredDate.ToLocalTime().ToString("d MMM yyyy HH:mm:ss")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Action" Sortable="false">
            <CellTemplate Context="cell">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@cell.Item.Action</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actor" Sortable="false">
            <CellTemplate Context="cell">
                @(cell.Item.ActorDisplayName ?? (cell.Item.ActorUserId is { } id ? $"user #{id}" : "system"))
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Target" Sortable="false">
            <CellTemplate Context="cell">
                @if (cell.Item.TargetType is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="fg-mono-raw">@cell.Item.TargetType @cell.Item.TargetId</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent Context="row">
        <MudTd colspan="5">
            <AuditDetails Details="@row.Item.Details" />
        </MudTd>
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4" data-testid="audit-empty">
            @(_loadFailed ? _errorMessage : "No audit entries match these filters.")
        </MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="AuditLogEntryResponse" />
    </PagerContent>
</MudDataGrid>

@code {
    private const int PageSize = 25;

    /// <summary>How many people the actor type-ahead offers per keystroke — a shortlist, not a browser.</summary>
    private const int ActorSuggestionCount = 10;

    /// <summary>The known <c>AuditLog.Action</c> values, straight off the Domain constants.</summary>
    public static readonly IReadOnlyList<string> Actions = ConstantSet.StringConstants(typeof(AuditActions));

    /// <summary>The known <c>AuditLog.TargetType</c> values, straight off the Domain constants.</summary>
    public static readonly IReadOnlyList<string> TargetTypes = ConstantSet.StringConstants(typeof(AuditTargetTypes));

    /// <summary>
    /// <c>?action=</c> — a deep link into one kind of entry, so a page that knows which action
    /// explains its number can hand the admin the trail rather than the whole log (the dashboard's
    /// hard-stopped card links to <c>key.revoked</c>, #190). Applied on first render only; changing
    /// the filter afterwards does not rewrite the URL.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "action")]
    public string? ActionFilter { get; set; }

    /// <summary>
    /// <c>?actor=</c> — the id path #191 asked to keep working, so a link to "everything this person
    /// did" survives being pasted into a chat. The name is looked up once so the box shows who it is
    /// rather than a number; a user the API can't resolve still filters by the id.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "actor")]
    public int? ActorFilter { get; set; }

    private MudDataGrid<AuditLogEntryResponse>? _grid;
    private string? _action;
    private string? _targetType;
    private int? _actorUserId;
    private UserResponse? _actor;
    private DateRange? _dateRange;
    private bool _loadFailed;
    private string _errorMessage = string.Empty;

    private bool HasFilters => _action is not null || _targetType is not null || _actorUserId is not null || _dateRange is not null;

    /// <summary>
    /// One page of the audit trail. Every filter is applied by the API (<c>GET /audit</c>) rather
    /// than in the browser — the log is unbounded, so client-side filtering would be filtering the
    /// wrong 25 rows.
    /// </summary>
    private async Task<GridData<AuditLogEntryResponse>> LoadAsync(GridState<AuditLogEntryResponse> state, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(state);

        var query = new AuditLogQuery(
            ActorUserId: _actorUserId,
            Action: _action,
            TargetType: _targetType,
            TargetId: null,
            FromDate: _dateRange?.Start is { } start ? ToInstant(start.Date) : null,
            // Inclusive of the whole end day: an admin who picks "3 Sep" means everything that
            // happened on the 3rd, not everything before midnight that morning.
            ToDate: _dateRange?.End is { } end ? ToInstant(end.Date.AddDays(1).AddTicks(-1)) : null);

        var paging = new PagedRequest(state.Page + 1, state.PageSize);
        var result = await ApiClient.GetAuditLogAsync(query, paging, cancellationToken);

        if (result.IsSuccess && result.Value is not null)
        {
            _loadFailed = false;
            return new GridData<AuditLogEntryResponse>
            {
                Items = result.Value.Items,
                TotalItems = result.Value.TotalCount,
            };
        }

        _loadFailed = true;
        _errorMessage = result.Message ?? "Couldn't load the audit log.";
        Snackbar.Add(_errorMessage, Severity.Error);
        return new GridData<AuditLogEntryResponse> { Items = [], TotalItems = 0 };
    }

    /// <summary>
    /// A date the picker produced, as the instant it names in the admin's own time zone. The
    /// picker hands back wall-clock dates and the grid renders <c>OccurredDate.ToLocalTime()</c>,
    /// so reading those dates as UTC would offset the filter window from the timestamps on screen
    /// by the reader's UTC offset — every admin outside UTC would see the wrong day's entries.
    /// The zone comes from the injected <see cref="TimeProvider"/> rather than
    /// <see cref="TimeZoneInfo.Local"/> so a test can pin it.
    /// </summary>
    private DateTimeOffset ToInstant(DateTime localWallClock) =>
        new(DateTime.SpecifyKind(localWallClock, DateTimeKind.Unspecified), TimeProvider.LocalTimeZone.GetUtcOffset(localWallClock));

    /// <summary>
    /// Keeps the query-string filters in step, including a later in-app navigation to them. An
    /// action the log's own constants don't name is ignored rather than being pushed into a select
    /// that cannot render it — a mistyped deep link shows the whole log, not an empty grid filtered
    /// by nothing that exists. An <c>?actor=</c> id is taken at face value (the API is the authority
    /// on whether that user exists) and its name resolved for the box.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var changed = false;

        var actionFromQuery = Actions.FirstOrDefault(a => string.Equals(a, ActionFilter, StringComparison.OrdinalIgnoreCase));
        if (actionFromQuery is not null && !string.Equals(actionFromQuery, _action, StringComparison.Ordinal))
        {
            _action = actionFromQuery;
            changed = true;
        }

        if (ActorFilter is { } actorFromQuery && actorFromQuery != _actorUserId)
        {
            _actorUserId = actorFromQuery;
            _actor = await TryLoadUserAsync(actorFromQuery);
            changed = true;
        }

        if (changed && _grid is not null)
        {
            await ReloadAsync();
        }
    }

    /// <summary>
    /// The type-ahead over <c>GET /users?search=</c>. An all-digits term also asks
    /// <c>GET /users/{id}</c>, so an admin who has an id — from a deep link, an export, a colleague's
    /// message — can still use it without leaving for <c>/users</c>. Search failures return nothing
    /// rather than throwing: the filter is a convenience, and the grid is the thing that reports a
    /// dead API.
    /// </summary>
    private async Task<IEnumerable<UserResponse>> SearchActorsAsync(string? value, CancellationToken cancellationToken)
    {
        var term = value?.Trim() ?? string.Empty;

        var result = await ApiClient.GetUsersAsync(
            new UserListQuery(string.IsNullOrEmpty(term) ? null : term, IsActive: null),
            new PagedRequest(1, ActorSuggestionCount),
            cancellationToken);

        var matches = result is { IsSuccess: true, Value: not null } ? result.Value.Items.ToList() : [];

        if (int.TryParse(term, NumberStyles.None, CultureInfo.InvariantCulture, out var userId)
            && !matches.Exists(u => u.UserId == userId))
        {
            var byId = await TryLoadUserAsync(userId, cancellationToken);
            if (byId is not null)
            {
                matches.Insert(0, byId);
            }
        }

        return matches;
    }

    /// <summary>One user by id, or <see langword="null"/> for any failure — a 404 for a typed id is an answer, not an error to report.</summary>
    private async Task<UserResponse?> TryLoadUserAsync(int userId, CancellationToken cancellationToken = default)
    {
        var result = await ApiClient.GetUserAsync(userId, cancellationToken);
        return result is { IsSuccess: true, Value: not null } ? result.Value.User : null;
    }

    private Task OnActorChangedAsync(UserResponse? actor) =>
        ApplyFilterAsync(() =>
        {
            _actor = actor;
            _actorUserId = actor?.UserId;
        });

    private static string ActorLabel(UserResponse? user) =>
        user is null ? string.Empty : $"{user.DisplayName} (#{user.UserId})";

    private async Task ApplyFilterAsync(Action mutate)
    {
        mutate();
        await ReloadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _action = null;
        _targetType = null;
        _actorUserId = null;
        _actor = null;
        _dateRange = null;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_grid is null)
        {
            return;
        }

        // Back to the first page before reloading. ReloadServerData() keeps the current page, so
        // narrowing a filter while on page 20 asks the API for page 20 of the narrowed set and
        // renders "no entries match" for a filter that has plenty.
        if (_grid.CurrentPage != 0)
        {
            _grid.NavigateTo(Page.First);
        }

        await _grid.ReloadServerData();
    }
}
