@page "/requests/{Id:int}"
@attribute [Authorize]
@inject IFoundryGateApiClient Api
@inject QuotaTierCatalog Tiers
@inject ISnackbar Snackbar

<PageTitle>Request #@Id — Foundry Gate</PageTitle>

@if (_accessDenied)
{
    <AccessDenied />
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning" data-testid="request-not-found">
        There's no request #@Id you can see. The API answers 404 for someone else's request as
        well as for one that doesn't exist.
        <MudLink Href="requests" Class="ml-2">Back to requests</MudLink>
    </MudAlert>
}
else if (_request is null)
{
    <MudSkeleton Width="18rem" Height="3rem" data-testid="request-loading" />
    <MudSkeleton Width="100%" Height="12rem" Class="mt-4" />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="requests" Class="mb-2">All requests</MudButton>
    <MudText Typo="Typo.h4" Class="mb-4">Request #@Id</MudText>

    <MudPaper Elevation="1" Class="pa-6" Style="max-width: 44rem;">
        @* The same component the /requests drawer renders — one description of a request,
           one review flow, two places to reach it. *@
        <RequestReviewPanel Request="@_request"
                            Tiers="@_tiers"
                            CanReview="@_isAdmin"
                            OnReviewed="@OnReviewedAsync" />
    </MudPaper>
}

@code {
    /// <summary>QuotaIncreaseRequestId from the route.</summary>
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private QuotaIncreaseRequestResponse? _request;
    private IReadOnlyList<QuotaTierResponse> _tiers = [];
    private bool _isAdmin;
    private bool _accessDenied;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            _isAdmin = state.User.IsInRole(RoleNames.Admin);
        }

        _tiers = await Tiers.GetAsync();
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetRequestAsync(Id);
        switch (result.Status)
        {
            case ApiCallStatus.Forbidden:
                _accessDenied = true;
                return;
            case ApiCallStatus.NotFound:
                _notFound = true;
                _request = null;
                return;
        }

        if (!result.IsSuccess || result.Value is null)
        {
            Snackbar.Add(result.Message ?? "Couldn't load this request.", Severity.Error);
            return;
        }

        _notFound = false;
        _request = result.Value;
    }

    /// <summary>
    /// Unlike the drawer, this page re-reads straight away, so there is nothing for the optimistic
    /// record to bridge — the reviewer and the timestamp come back from the server instead of
    /// being guessed at for one render.
    /// </summary>
    private Task OnReviewedAsync(QuotaIncreaseRequestResponse reviewed) => LoadAsync();
}
