@inject IFoundryGateApiClient Api
@inject TimeProvider Time

@* Create form for POST /foundry/deployments (#62). OpenAI format only — the API refuses an
   Anthropic-format create with a 400, so this dialog never offers one and says why instead of
   letting the user find out from an error.

   Model, version and SKU are offered from GET /foundry/catalog (#173) — what the configured
   accounts can actually serve — not from a list typed into this file, which went stale the week
   after it shipped. The catalogue is filtered to OpenAI here: the endpoint lists Anthropic models
   for visibility, but this form submits ModelFormat = OpenAI, so offering one would send an
   Anthropic create disguised as an OpenAI one, straight past the API's refusal. Every field still
   coerces whatever is typed: the catalogue is a shortcut, and ARM is the authority on whether a
   create is valid. *@

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Claude deployments aren't created here. They need an attestation block the ARM SDK
            can't send yet, and Bicep can only recreate a whole account's deployments at once —
            so Foundry Gate's infra owns them end to end. This form creates OpenAI-format
            deployments only.
        </MudAlert>

        @if (_catalogUnavailable)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4" data-testid="deployment-catalog-unavailable">
                The model catalogue couldn't be read, so there are no suggestions below. Type the
                model, version and SKU exactly as Azure spells them and the create will still go
                through — Azure decides either way.
            </MudAlert>
        }

        <MudForm @ref="_form">
            <MudAutocomplete T="string"
                             @bind-Value="_accountName"
                             Label="Foundry account"
                             Variant="Variant.Outlined"
                             SearchFunc="@SearchAccountsAsync"
                             CoerceValue="true"
                             CoerceText="true"
                             OpenOnFocus="true"
                             Required="true"
                             RequiredError="Name the account to deploy into."
                             HelperText="One account per region. Pick an existing one, or type a configured account that has no deployments yet."
                             data-testid="deployment-account" />

            <MudTextField @bind-Value="_deploymentName"
                          Label="Deployment name"
                          Variant="Variant.Outlined"
                          Class="mt-4"
                          Required="true"
                          RequiredError="A deployment needs a name."
                          MaxLength="@ValidationConstants.FoundryDeploymentNameMaxLength"
                          HelperText="What callers put in the model field. Letters, digits, and . _ - after the first character."
                          data-testid="deployment-name" />

            <MudAutocomplete T="string"
                             Value="@_modelName"
                             ValueChanged="@OnModelChangedAsync"
                             Label="Model"
                             Variant="Variant.Outlined"
                             Class="mt-4"
                             SearchFunc="@SearchModelsAsync"
                             CoerceValue="true"
                             CoerceText="true"
                             OpenOnFocus="true"
                             Required="true"
                             RequiredError="Name the model to deploy."
                             HelperText="@ModelHelperText"
                             data-testid="deployment-model" />

            <MudAutocomplete T="string"
                             Value="@_modelVersion"
                             ValueChanged="@OnVersionChanged"
                             Label="Model version"
                             Variant="Variant.Outlined"
                             Class="mt-4"
                             SearchFunc="@SearchVersionsAsync"
                             CoerceValue="true"
                             CoerceText="true"
                             OpenOnFocus="true"
                             Required="true"
                             RequiredError="ARM needs an explicit version."
                             MaxLength="@ValidationConstants.FoundryModelVersionMaxLength"
                             HelperText="@VersionHelperText"
                             data-testid="deployment-version" />

            <MudAutocomplete T="string"
                             Value="@_skuName"
                             ValueChanged="@OnSkuChanged"
                             Label="SKU"
                             Variant="Variant.Outlined"
                             Class="mt-4"
                             SearchFunc="@SearchSkusAsync"
                             CoerceValue="true"
                             CoerceText="true"
                             OpenOnFocus="true"
                             Required="true"
                             RequiredError="ARM needs a SKU."
                             MaxLength="@ValidationConstants.FoundrySkuNameMaxLength"
                             data-testid="deployment-sku" />

            <MudNumericField T="int"
                             Value="@_capacity"
                             ValueChanged="@OnCapacityChanged"
                             Label="Capacity"
                             Variant="Variant.Outlined"
                             Class="mt-4"
                             Min="1"
                             Max="@ValidationConstants.FoundryDeploymentMaxCapacity"
                             HelperText="Thousands of tokens per minute — 25 means 25,000 TPM."
                             data-testid="deployment-capacity" />

            @if (_retiredCount > 0)
            {
                @* Retired models are hidden rather than removed: deploying one is legitimate (matching
                   an existing deployment's version, reproducing a fork's setup) but it should be a
                   deliberate act, not something you scroll past by accident. *@
                <MudSwitch T="bool"
                           Value="@_includeRetired"
                           ValueChanged="@OnIncludeRetiredChanged"
                           Color="Color.Warning"
                           Class="mt-4"
                           data-testid="deployment-include-retired">
                    Show @_retiredCount retired model@(_retiredCount == 1 ? string.Empty : "s")
                </MudSwitch>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" data-testid="deployment-cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitAsync" data-testid="deployment-create">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Capacity a form starts at when the catalogue suggests nothing — the value #62 shipped.</summary>
    private const int FallbackCapacity = 25;

    [CascadingParameter]
    private IMudDialogInstance Instance { get; set; } = default!;

    /// <summary>Accounts already known to have deployments, so the common case is a pick not a guess.</summary>
    [Parameter]
    public IReadOnlyList<string> KnownAccounts { get; set; } = [];

    private MudForm? _form;

    /// <summary>
    /// The OpenAI-format half of <c>GET /foundry/catalog</c>. The endpoint lists Anthropic models too —
    /// what an account can serve is worth knowing — but this form hardcodes
    /// <see cref="FoundryModelFormatType.OpenAI"/> on submit, so offering a <c>claude-*</c> model would
    /// send an Anthropic create *as* an OpenAI one, sailing past the API's refusal and putting a failed
    /// Anthropic create in front of ARM (E-007: that can wedge the subscription's Marketplace
    /// agreement). The filter is what keeps the banner above true.
    /// </summary>
    private IReadOnlyList<FoundryCatalogEntryResponse> _catalog = [];
    private bool _catalogUnavailable;
    private bool _includeRetired;
    private int _retiredCount;
    private string _accountName = string.Empty;
    private string _deploymentName = string.Empty;
    private string _modelName = string.Empty;
    private string _modelVersion = string.Empty;
    private string _skuName = string.Empty;
    private int _capacity = FallbackCapacity;

    /// <summary>
    /// Version, SKU and capacity are <em>derived</em> from the chosen model until the admin says
    /// otherwise: each flag is set the moment they edit that field themselves, and cleared when an
    /// auto-fill replaces it. Without this, changing your mind about the model left the previous
    /// model's version and SKU in the boxes and posted them — while capacity, which tracked its own
    /// edits, re-filled correctly, so the three fields disagreed about whether an auto-fill counted as
    /// the admin's answer. Now they agree: filled-in values follow the model, typed values don't.
    /// </summary>
    private bool _versionEdited;
    private bool _skuEdited;
    private bool _capacityEdited;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetFoundryCatalogAsync();
        if (result is { IsSuccess: true, Value: not null })
        {
            _catalog = [.. result.Value.Where(IsCreatableHere)];
        }

        _retiredCount = _catalog.Count(entry => entry.IsRetiredAt(Time.GetUtcNow()));

        // "Couldn't read it" and "the accounts serve nothing this form can create" are the same thing
        // here: no suggestions, free text, and a note saying so.
        _catalogUnavailable = _catalog.Count == 0;

        if (KnownAccounts.Count == 1)
        {
            _accountName = KnownAccounts[0];
        }
    }

    /// <summary>
    /// Only the format this form can actually submit. An Anthropic entry is dropped here rather than
    /// hidden per-picker, so no field can offer one by a route the model picker didn't.
    /// </summary>
    private static bool IsCreatableHere(FoundryCatalogEntryResponse entry) =>
        string.Equals(entry.ModelFormat, nameof(FoundryModelFormatType.OpenAI), StringComparison.OrdinalIgnoreCase);

    /// <summary>Everything the pickers may offer right now — retired models only when the admin asked for them.</summary>
    private IEnumerable<FoundryCatalogEntryResponse> Offerable =>
        _includeRetired ? _catalog : _catalog.Where(entry => !entry.IsRetiredAt(Time.GetUtcNow()));

    private string ModelHelperText => _catalogUnavailable
        ? "Type the model exactly as Azure spells it."
        : "Suggestions are the OpenAI-format models the configured accounts can serve. Anything typed is accepted — Azure decides.";

    private string? VersionHelperText
    {
        get
        {
            var entry = EntriesForModel().FirstOrDefault(e => string.Equals(e.ModelVersion, _modelVersion, StringComparison.OrdinalIgnoreCase));
            return entry?.InferenceRetiresOn is { } retiresOn
                ? $"Azure retires this version on {retiresOn.ToLocalTime():d MMM yyyy} — deployments of it stop answering then."
                : null;
        }
    }

    private Task<IEnumerable<string>> SearchAccountsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(Filter(KnownAccounts, value));

    private Task<IEnumerable<string>> SearchModelsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(Filter(
            [.. Offerable.Select(entry => entry.ModelName).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)],
            value));

    /// <summary>
    /// Versions of the chosen model, ARM's default first. Before a model is chosen there is nothing
    /// honest to offer — every version in the catalogue would be a list of dates belonging to other
    /// models.
    /// </summary>
    private Task<IEnumerable<string>> SearchVersionsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(Filter([.. EntriesForModel().Select(entry => entry.ModelVersion).Where(v => v.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase)], value));

    /// <summary>The SKUs the chosen model can be deployed under; every offerable SKU once no model is chosen.</summary>
    private Task<IEnumerable<string>> SearchSkusAsync(string value, CancellationToken cancellationToken)
    {
        var source = _modelName.Length > 0 ? EntriesForModel() : [.. Offerable];
        return Task.FromResult(Filter(
            [.. source.SelectMany(entry => entry.SkuNames).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)],
            value));
    }

    /// <summary>
    /// Choosing a model fills in what the catalogue knows about it — ARM's default version, ARM's
    /// default SKU, and the capacity ARM suggests for that SKU — so the common case is one pick rather
    /// than four. These are <em>derived</em> fields: switching models re-derives them, because the
    /// previous model's version and SKU are not an answer to the new question. A field the admin typed
    /// themselves is theirs and is left alone.
    /// </summary>
    private Task OnModelChangedAsync(string? modelName)
    {
        _modelName = modelName ?? string.Empty;
        ApplyModelDefaults();
        return Task.CompletedTask;
    }

    private void ApplyModelDefaults()
    {
        var entry = EntriesForModel().FirstOrDefault();
        if (entry is null)
        {
            // A model the catalogue doesn't list (typed, or hidden as retired): nothing to derive
            // from, and the fields already on screen are the admin's best guess. Leave them.
            return;
        }

        if (!_versionEdited && entry.ModelVersion.Length > 0)
        {
            _modelVersion = entry.ModelVersion;
        }

        // ARM's own first SKU, not SkuNames[0] — that list is sorted for the dropdown, and the
        // suggested capacity below belongs to this SKU specifically (capacity limits are per-SKU).
        if (!_skuEdited && entry.DefaultSkuName.Length > 0)
        {
            _skuName = entry.DefaultSkuName;
        }

        if (!_capacityEdited && entry.DefaultCapacity is { } defaultCapacity and > 0)
        {
            _capacity = defaultCapacity;
        }
    }

    private void OnVersionChanged(string? modelVersion)
    {
        _modelVersion = modelVersion ?? string.Empty;
        _versionEdited = true;
    }

    private void OnSkuChanged(string? skuName)
    {
        _skuName = skuName ?? string.Empty;
        _skuEdited = true;
    }

    private void OnCapacityChanged(int capacity)
    {
        _capacity = capacity;
        _capacityEdited = true;
    }

    /// <summary>
    /// Revealing retired models can bring the chosen model's own entry into scope (it may itself be
    /// retired), so the derived fields are re-applied — otherwise the version box would keep showing
    /// nothing for a model the form can now describe.
    /// </summary>
    private void OnIncludeRetiredChanged(bool includeRetired)
    {
        _includeRetired = includeRetired;
        ApplyModelDefaults();
    }

    /// <summary>
    /// The offerable catalogue entries for the currently named model, ARM's default version first (the
    /// endpoint orders them that way, so <c>First()</c> is the version to suggest).
    /// </summary>
    private List<FoundryCatalogEntryResponse> EntriesForModel() =>
        [.. Offerable.Where(entry => string.Equals(entry.ModelName, _modelName, StringComparison.OrdinalIgnoreCase))];

    private static IEnumerable<string> Filter(IReadOnlyList<string> source, string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? source
            : source.Where(item => item.Contains(value, StringComparison.OrdinalIgnoreCase));

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        // CreateFoundryDeploymentRequest's properties are init-only (the repo's request-DTO
        // convention), so the form binds to locals and the record is built once, here.
        var request = new CreateFoundryDeploymentRequest
        {
            AccountName = _accountName.Trim(),
            DeploymentName = _deploymentName.Trim(),
            ModelFormat = FoundryModelFormatType.OpenAI,
            ModelName = _modelName.Trim(),
            ModelVersion = _modelVersion.Trim(),
            SkuName = _skuName.Trim(),
            Capacity = _capacity,
        };

        Instance.Close(DialogResult.Ok(request));
    }

    private void Cancel() => Instance.Cancel();
}
