<MudNavMenu Class="pa-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavGroup Title="Developer" Icon="@Icons.Material.Filled.Person" Expanded="true">
                <MudNavLink Href="me" Icon="@Icons.Material.Filled.Dashboard">My Account</MudNavLink>
                <MudNavLink Href="me/request" Icon="@Icons.Material.Filled.Add">Request Quota Increase</MudNavLink>
                <MudNavLink Href="requests" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">My Requests</MudNavLink>
            </MudNavGroup>

            <AuthorizeView Roles="@RoleNames.Admin" Context="adminContext">
                <Authorized>
                    <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                        <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.SpaceDashboard">Dashboard</MudNavLink>
                        <MudNavLink Href="users" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">Users</MudNavLink>
                        <MudNavLink Href="users/sync" Icon="@Icons.Material.Filled.Sync">Sync Entra Users</MudNavLink>
                        <MudNavLink Href="groups" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Groups">Groups</MudNavLink>
                        <MudNavLink Href="groups/new" Icon="@Icons.Material.Filled.AddCircleOutline">New Group</MudNavLink>
                        <MudNavLink Href="requests" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FactCheck">All Requests</MudNavLink>
                        <MudNavLink Href="config" Icon="@Icons.Material.Filled.Settings">Configuration</MudNavLink>
                        <MudNavLink Href="audit" Icon="@Icons.Material.Filled.History">Audit Log</MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
