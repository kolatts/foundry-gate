@using FoundryGate.Domain.Quota.Contracts

@* The developer's monthly budget, as a bar (#49). Since D-013 the budget IS a gateway tier, so
   the tier name sits next to the number: the number is what the control plane reconciled, the
   tier is what the gateway actually enforces. Colour thresholds live in TierDisplay so they are
   testable without reading CSS classes. *@

<div data-testid="quota-gauge">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.subtitle2" Class="fg-label">@Title</MudText>
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Outlined"
                 Color="@(Allocation.IsUnlimited ? Color.Success : Color.Primary)"
                 Icon="@(Allocation.IsUnlimited ? Icons.Material.Filled.AllInclusive : Icons.Material.Filled.Workspaces)"
                 data-testid="quota-tier-chip">
            @TierDisplay.TierDisplayName(Allocation.TierProductId)
        </MudChip>
    </div>

    @if (Allocation.IsUnlimited)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AllInclusive" data-testid="quota-unlimited">
            No monthly budget — the gateway smooths bursts but never stops you for the month.
            You've used @TierDisplay.FormatTokensExact(Allocation.TokensUsed) tokens so far.
        </MudAlert>
    }
    else
    {
        <MudProgressLinear Color="@TierDisplay.GaugeColor(Allocation.PercentUsed)"
                           Value="@TierDisplay.GaugeValue(Allocation.PercentUsed)"
                           Size="Size.Large"
                           Rounded="true"
                           Class="my-2"
                           data-testid="quota-bar" />

        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.body2" Class="fg-mono" data-testid="quota-numbers">
                @TierDisplay.FormatTokensExact(Allocation.TokensUsed) / @TierDisplay.FormatTokensExact(Allocation.AllocatedTokens) tokens
            </MudText>
            <MudText Typo="Typo.body2" Class="fg-mono mud-text-secondary" data-testid="quota-percent">
                @($"{TierDisplay.GaugeValue(Allocation.PercentUsed):0.#}%")
            </MudText>
        </div>
    }

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        Period @Allocation.PeriodYear-@Allocation.PeriodMonth.ToString("00", System.Globalization.CultureInfo.InvariantCulture),
        resolved from @TierDisplay.LevelSentence(Allocation.ResolvedLevelType). Usage is reconciled from gateway
        logs, so it can trail your last few requests; the gateway itself enforces in real time.
    </MudText>

    @if (Allocation.IsGatewayCapped)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Icon="@Icons.Material.Filled.ReportProblem" data-testid="quota-gateway-capped">
            The number above doesn't match any configured tier, so the gateway is enforcing the
            next tier up (@TierDisplay.TierDisplayName(Allocation.TierProductId)) instead. Ask an
            admin to move you onto a tier so the two agree.
        </MudAlert>
    }

    @if (Allocation.IsHardStopped)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" Icon="@Icons.Material.Filled.Block" data-testid="quota-hard-stopped">
            Your gateway key has been revoked by an administrator. Requests will fail until it's
            re-provisioned — this is not a budget problem.
        </MudAlert>
    }
</div>

@code {
    /// <summary>The allocation to render — from <c>GET /users/me</c>'s <c>quota</c>, or any of the <c>/quota/allocations</c> reads.</summary>
    [Parameter, EditorRequired]
    public QuotaAllocationResponse Allocation { get; set; } = null!;

    /// <summary>Heading above the bar. Defaults to the <c>/me</c> wording; the admin views pass their own.</summary>
    [Parameter]
    public string Title { get; set; } = "This month's usage";
}
