# ─── Secrets / local config ──────────────────────────────────
appsettings.Development.json
appsettings.Local.json
appsettings.Secrets.json
*.pfx
*.p12

# FoundryGate.Api's appsettings.Development.json is deliberately checked in: it only points at
# the docker-compose local SQL instance (same plaintext dev-only password already committed in
# docker-compose.yml), never a real secret. CONVENTIONS.md/plans/02-data-layer.md require this
# default to exist in source so `AddFoundryGateData` has a connection string out of the box.
!src/FoundryGate.Api/appsettings.Development.json

# Same for both hosts' appsettings.local.json: since #201 they are the only place the quota tier
# table lives for `ASPNETCORE_ENVIRONMENT`/`DOTNET_ENVIRONMENT` = local (a deployed host gets it from
# infra as Gateway__Tiers__*), so a fork that cloned the repo and could not start locally would be
# the cost of ignoring them. They carry the docker-compose SQL password and nothing else secret.
!src/FoundryGate.Api/appsettings.local.json
!src/FoundryGate.Functions/appsettings.local.json

