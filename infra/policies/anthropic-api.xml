<policies>
  <!--
    Anthropic Messages front door (Claude Code). API scope owns MECHANISM only;
    ENTITLEMENT (model allowlist + TPM + monthly quota) lives in the tier product policy
    — see infra/policies/product-policy.xml for the full split and ordering rationale.
    There is deliberately no `llm-token-limit` here: exactly one scope may declare it or
    every request is counted twice.
  -->
  <inbound>
    <!-- BEFORE <base />, so it runs before the product scope would have: all
         enforcement lives in the tier product policy, so a subscription with no product
         context (APIM's built-in all-access subscription, or any subscription scoped
         outside a tier) would otherwise skip the allowlist and both meters entirely. -->
    <include-fragment fragment-id="fg-require-product" />
    <!-- Also BEFORE <base />, so it is a DEFAULT the product policy can override. The
         alias fragment (product scope, runs when <base /> expands) points each permitted
         model at its own pool; anything it does not touch — a request with no `model`,
         or a fork that has not populated an alias map — still lands on the pool rather
         than the single-region serviceUrl. -->
    <set-backend-service backend-id="__ANTHROPIC_POOL_ID__" />
    <base />
    <include-fragment fragment-id="fg-backend-auth" />
    <include-fragment fragment-id="fg-token-metrics" />
  </inbound>
  <backend>
    <!-- Retries re-enter the pool; a circuit-broken (429-saturated) backend is skipped,
         so the retry lands on the healthy region. buffer-request-body is required to
         resend the body and is a real memory input to APIM capacity planning (agent
         harness requests run 50-200KB). buffer-response=false keeps SSE streaming. -->
    <retry condition="@(context.Response != null &amp;&amp; (context.Response.StatusCode == 429 || context.Response.StatusCode == 503))"
           count="2" interval="1" first-fast-retry="true">
      <forward-request buffer-request-body="true" buffer-response="false" />
    </retry>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
