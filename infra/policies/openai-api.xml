<policies>
  <!--
    OpenAI v1 front door (Codex CLI and OpenAI-compatible clients). Same split as the
    Anthropic policy: API scope = mechanism, tier product policy = entitlement. The two
    files now share everything that is genuinely identical through fragments; what
    remains different is real (backend topology and retry semantics), so it stays
    duplicated on purpose.
  -->
  <inbound>
    <!-- BEFORE <base />, so it runs before the product scope would have: all
         enforcement lives in the tier product policy, so a subscription with no product
         context (APIM's built-in all-access subscription, or any subscription scoped
         outside a tier) would otherwise skip the allowlist and both meters entirely. -->
    <include-fragment fragment-id="fg-require-product" />
    <!-- Default backend, overridable by the product-scope alias fragment. Requests with
         no `model` in the body (GET /models) never reach the fragment's rewrite branch
         and land here. -->
    <set-backend-service backend-id="__OPENAI_BACKEND_ID__" />
    <base />
    <include-fragment fragment-id="fg-backend-auth" />
    <include-fragment fragment-id="fg-token-metrics" />
  </inbound>
  <backend>
    <!-- No retry here: this is a single backend with no pool — retrying a 429 would
         only hammer an already-throttled deployment. buffer-response=false keeps SSE
         streaming unbuffered. -->
    <forward-request buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
