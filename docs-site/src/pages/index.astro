---
// Foundry Gate — marketing landing page
// Replaces the Starlight splash; Starlight still handles all /docs/* routes
// CLAUDE.md invariant #1: this page is a dead-simple explainer for people who
// don't understand technology. Plain language only in the hero and story
// sections. Demo data below is hardcoded fake data; the "This is real"
// section shows genuine responses captured from a live gateway (2026-09-01).
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Foundry Gate — Give every developer their own AI budget</title>
  <meta name="description" content="FoundryGate hands out the keys, watches the meter, and stops overspending — automatically. AI budgets for every developer, running in your own Azure account." />
  <meta property="og:title" content="Foundry Gate" />
  <meta property="og:description" content="Give every developer their own AI budget. FoundryGate hands out the keys, watches the meter, and stops overspending — automatically." />
  <meta property="og:image" content={`${base}og-logo.png`} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <style>
    /* ── Tokens ─────────────────────────────────────────── */
    :root {
      --fg-bg-base:     #080C12;
      --fg-bg-surface:  #0D1520;
      --fg-bg-raised:   #111927;
      --fg-bg-overlay:  #162032;
      --fg-border-subtle: #1E2D42;
      --fg-border-strong: #2D4460;
      --fg-azure-dim:   #0558A0;
      --fg-azure:       #0078D4;
      --fg-azure-hover: #3BA3E8;
      --fg-azure-neon:  #4DCFFF;
      --fg-ember-soft:  #FFB347;
      --fg-ember:       #F58025;
      --fg-ember-hot:   #FF5400;
      --fg-text-primary:   #E8EEF5;
      --fg-text-secondary: #A0B0C0;
      --fg-text-muted:     #6B7E94;
      --fg-success: #22C55E;
      --fg-info:    #38BDF8;
      --fg-font-ui:   'Inter', system-ui, -apple-system, sans-serif;
      --fg-font-mono: 'Monaspace Argon', 'Fira Code', monospace;
    }

    /* ── Reset ──────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      background: var(--fg-bg-base);
      color: var(--fg-text-primary);
      font-family: var(--fg-font-ui);
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; color: inherit; }

    /* ── Nav ────────────────────────────────────────────── */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2.5rem;
      height: 68px;
      border-bottom: 1px solid var(--fg-border-subtle);
      position: sticky;
      top: 0;
      background: color-mix(in srgb, var(--fg-bg-base) 82%, transparent);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      z-index: 50;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-logo img {
      height: 48px;
      filter: brightness(1.15) drop-shadow(0 0 6px rgba(77,207,255,0.15));
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .nav-links a {
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--fg-text-secondary);
      transition: color 0.18s, background 0.18s;
      position: relative;
      white-space: nowrap;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 0.75rem;
      right: 0.75rem;
      height: 1px;
      background: var(--fg-azure-neon);
      transform: scaleX(0);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      transform-origin: left;
    }

    .nav-links a:hover {
      color: var(--fg-text-primary);
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
    }

    .nav-signin {
      margin-left: 0.75rem;
      padding: 0.4rem 1.1rem !important;
      background: var(--fg-azure) !important;
      color: #fff !important;
      border-radius: 6px;
      font-weight: 600 !important;
      font-size: 13px;
      transition: background 0.18s, box-shadow 0.22s !important;
    }

    .nav-signin::after { display: none; }

    .nav-signin:hover {
      background: var(--fg-azure-hover) !important;
      box-shadow: 0 0 16px 2px color-mix(in srgb, var(--fg-azure-neon) 30%, transparent) !important;
    }

    /* ── Hero ───────────────────────────────────────────── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 3rem;
      align-items: center;
      min-height: calc(100vh - 68px);
      padding: 3rem 2.5rem 3rem 3.5rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg-azure-neon);
      background: color-mix(in srgb, var(--fg-azure) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--fg-azure) 30%, transparent);
      padding: 0.3rem 0.75rem;
      border-radius: 100px;
      width: fit-content;
    }

    h1 {
      font-size: clamp(2.6rem, 4.2vw, 4rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.03em;
      color: var(--fg-text-primary);
    }

    h1 .accent {
      color: var(--fg-azure-neon);
    }

    .hero-sub {
      font-size: 1.05rem;
      line-height: 1.65;
      color: var(--fg-text-secondary);
      max-width: 44ch;
    }

    .cta-group {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      flex-wrap: wrap;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.65rem 1.4rem;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      background: var(--fg-azure);
      color: #fff;
      transition: background 0.2s, box-shadow 0.25s;
    }

    .btn-primary:hover {
      background: var(--fg-azure-hover);
      box-shadow: 0 0 20px 2px color-mix(in srgb, var(--fg-azure-neon) 30%, transparent);
      transform: translateY(-1px);
    }

    .btn-primary, .btn-secondary { transition: background 0.2s, box-shadow 0.25s, border-color 0.2s, color 0.2s, transform 0.2s cubic-bezier(0.16,1,0.3,1); }
    .btn-secondary:hover { transform: translateY(-1px); }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.65rem 1.4rem;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      border: 1px solid var(--fg-border-strong);
      color: var(--fg-text-secondary);
    }

    .btn-secondary:hover {
      border-color: var(--fg-azure);
      color: var(--fg-text-primary);
    }

    /* ── Flow steps (the four-step story) ───────────────── */
    .hero-flow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    .flow-arrow { display: none; }

    .flow-step {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      background: var(--fg-bg-surface);
      border: 1px solid var(--fg-border-subtle);
      border-radius: 8px;
      padding: 0.6rem 0.75rem;
      transition: border-color 0.2s;
      flex: 1;
      min-width: 140px;
    }

    .flow-step {
      transition: border-color 0.2s, transform 0.25s cubic-bezier(0.16,1,0.3,1), background 0.2s;
    }

    .flow-step:hover {
      border-color: var(--fg-border-strong);
      background: var(--fg-bg-raised);
      transform: translateY(-2px);
    }

    .flow-icon {
      color: var(--fg-azure-neon);
      font-size: 13px;
      font-weight: 700;
      line-height: 1.4;
      flex-shrink: 0;
      font-family: var(--fg-font-mono);
    }

    .flow-label {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--fg-text-primary);
      margin-bottom: 0.2rem;
    }

    .flow-desc {
      font-size: 10.5px;
      color: var(--fg-text-muted);
      line-height: 1.45;
    }

    .flow-arrow {
      color: var(--fg-border-strong);
      font-size: 16px;
      align-self: center;
      flex-shrink: 0;
    }

    .hero-icons {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-top: 0.5rem;
    }

    .hero-icons img {
      height: 18px;
      opacity: 0.35;
      filter: invert(1);
    }

    /* ── Dashboard screenshot ───────────────────────────── */
    .dashboard-wrap {
      position: relative;
    }

    .dashboard-wrap::before {
      content: '';
      position: absolute;
      inset: -40px;
      background: radial-gradient(ellipse at 60% 50%,
        color-mix(in srgb, var(--fg-azure) 8%, transparent) 0%,
        transparent 70%);
      pointer-events: none;
    }

    .dashboard-img {
      display: block;
      width: 100%;
      border-radius: 12px;
      border: 1px solid var(--fg-border-subtle);
      box-shadow:
        0 0 0 1px var(--fg-border-subtle),
        0 24px 64px color-mix(in srgb, #000 60%, transparent);
    }

    /* ── Sections below the hero ────────────────────────── */
    .section {
      position: relative;
      max-width: 1080px;
      margin: 0 auto;
      padding: 5rem 2.5rem 2rem;
    }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg-azure-neon);
      margin-bottom: 0.75rem;
    }

    .section h2 {
      font-size: clamp(1.7rem, 2.6vw, 2.3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }

    .section-sub {
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--fg-text-secondary);
      max-width: 62ch;
      margin-bottom: 2.25rem;
    }

    /* ── Demo dashboard (fake data) ─────────────────────── */
    .demo-panel {
      background: color-mix(in srgb, var(--fg-bg-surface) 88%, transparent);
      border: 1px solid var(--fg-border-subtle);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 18px 48px color-mix(in srgb, #000 45%, transparent);
    }

    .demo-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid var(--fg-border-subtle);
      background: var(--fg-bg-raised);
    }

    .demo-panel-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--fg-text-primary);
    }

    .demo-panel-badge {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--fg-text-muted);
      border: 1px dashed var(--fg-border-strong);
      border-radius: 100px;
      padding: 0.2rem 0.65rem;
      white-space: nowrap;
    }

    .demo-table-scroll { overflow-x: auto; }

    .demo-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      min-width: 640px;
    }

    .demo-table th {
      text-align: left;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-text-muted);
      padding: 0.7rem 1.25rem;
      border-bottom: 1px solid var(--fg-border-subtle);
      white-space: nowrap;
    }

    .demo-table td {
      padding: 0.8rem 1.25rem;
      border-bottom: 1px solid color-mix(in srgb, var(--fg-border-subtle) 55%, transparent);
      vertical-align: middle;
    }

    .demo-table tr:last-child td { border-bottom: none; }

    .demo-name {
      font-weight: 600;
      color: var(--fg-text-primary);
      white-space: nowrap;
    }

    .demo-email {
      display: block;
      font-size: 11px;
      color: var(--fg-text-muted);
      font-family: var(--fg-font-mono);
      margin-top: 0.15rem;
    }

    .demo-budget {
      font-family: var(--fg-font-mono);
      font-size: 12px;
      color: var(--fg-text-secondary);
      white-space: nowrap;
    }

    .meter {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-width: 170px;
    }

    .meter-track {
      flex: 1;
      height: 6px;
      border-radius: 100px;
      background: var(--fg-bg-overlay);
      overflow: hidden;
    }

    .meter-fill {
      display: block;
      height: 100%;
      border-radius: 100px;
      background: var(--fg-azure);
    }

    .meter-fill--warn { background: var(--fg-ember-soft); }
    .meter-fill--hot  { background: var(--fg-ember-hot); }
    .meter-fill--info { background: var(--fg-info); opacity: 0.55; }

    .meter-pct {
      font-family: var(--fg-font-mono);
      font-size: 11.5px;
      color: var(--fg-text-secondary);
      min-width: 3.2ch;
      text-align: right;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 11px;
      font-weight: 600;
      border-radius: 100px;
      padding: 0.22rem 0.7rem;
      white-space: nowrap;
    }

    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .badge--ok {
      color: var(--fg-success);
      background: color-mix(in srgb, var(--fg-success) 12%, transparent);
    }

    .badge--warn {
      color: var(--fg-ember-soft);
      background: color-mix(in srgb, var(--fg-ember-soft) 12%, transparent);
    }

    .badge--blocked {
      color: var(--fg-ember-hot);
      background: color-mix(in srgb, var(--fg-ember-hot) 14%, transparent);
    }

    .badge--info {
      color: var(--fg-info);
      background: color-mix(in srgb, var(--fg-info) 12%, transparent);
    }

    .badge--pending {
      color: var(--fg-azure-neon);
      background: color-mix(in srgb, var(--fg-azure-neon) 12%, transparent);
    }

    /* ── Evidence (real responses) ──────────────────────── */
    .proof-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .proof-card {
      display: flex;
      flex-direction: column;
      background: color-mix(in srgb, var(--fg-bg-surface) 90%, transparent);
      border: 1px solid var(--fg-border-subtle);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.25s cubic-bezier(0.16,1,0.3,1), box-shadow 0.25s;
    }

    .proof-card:hover {
      border-color: var(--fg-border-strong);
      transform: translateY(-3px);
      box-shadow: 0 12px 36px color-mix(in srgb, #000 45%, transparent);
    }

    .proof-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--fg-border-subtle);
      background: var(--fg-bg-raised);
    }

    .proof-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--fg-border-strong);
    }

    .proof-dot--green { background: var(--fg-success); }
    .proof-dot--amber { background: var(--fg-ember-soft); }
    .proof-dot--red   { background: var(--fg-ember-hot); }
    .proof-dot--blue  { background: var(--fg-azure-neon); }

    .proof-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--fg-text-secondary);
    }

    .proof-body {
      flex: 1;
      padding: 1rem 1.15rem;
      font-family: var(--fg-font-mono);
      font-size: 12px;
      line-height: 1.7;
      color: var(--fg-text-secondary);
      overflow-x: auto;
      white-space: pre;
    }

    .proof-body .st-ok   { color: var(--fg-success); font-weight: 700; }
    .proof-body .st-warn { color: var(--fg-ember-soft); font-weight: 700; }
    .proof-body .st-err  { color: var(--fg-ember-hot); font-weight: 700; }
    .proof-body .hdr     { color: var(--fg-azure-neon); }
    .proof-body .dim     { color: var(--fg-text-muted); }
    .proof-body .out     { color: var(--fg-text-primary); }

    .proof-caption {
      padding: 0.75rem 1.15rem 0.95rem;
      border-top: 1px solid color-mix(in srgb, var(--fg-border-subtle) 60%, transparent);
      font-size: 12.5px;
      line-height: 1.55;
      color: var(--fg-text-secondary);
    }

    .proof-note {
      margin-top: 1.5rem;
      font-size: 12px;
      color: var(--fg-text-muted);
      font-style: italic;
    }

    /* ── Bottom CTA & footer ────────────────────────────── */
    .cta-final {
      text-align: center;
      padding: 5rem 2.5rem 6rem;
      max-width: 720px;
      margin: 0 auto;
    }

    .cta-final h2 {
      font-size: clamp(1.6rem, 2.4vw, 2.1rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }

    .cta-final p {
      color: var(--fg-text-secondary);
      font-size: 0.98rem;
      line-height: 1.65;
      margin-bottom: 1.75rem;
    }

    .cta-final .cta-group { justify-content: center; }

    footer {
      position: relative;
      z-index: 2;
      border-top: 1px solid var(--fg-border-subtle);
      padding: 1.5rem 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      font-size: 12.5px;
      color: var(--fg-text-muted);
    }

    footer .footer-links {
      display: flex;
      gap: 1.25rem;
    }

    footer a { color: var(--fg-text-secondary); transition: color 0.18s; }
    footer a:hover { color: var(--fg-text-primary); }

    /* ── Ambient aurora layer ────────────────────────────── */
    .aurora {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    /* Nebula base — screen blend makes dark areas transparent */
    .aurora-nebula {
      position: absolute;
      inset: 0;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      /* background-image set inline on the element via ${base} so the page stays
         relocatable — the image is the one asset CSS can't reach base for. */
      opacity: 0.32;
      mix-blend-mode: screen;
    }

    .aurora-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      will-change: transform;
    }

    .aurora-1 {
      width: 700px; height: 480px;
      background: radial-gradient(ellipse, rgba(0,120,212,0.22) 0%, transparent 70%);
      top: -120px; left: -80px;
      animation: orb1 24s ease-in-out infinite alternate;
    }

    .aurora-2 {
      width: 520px; height: 660px;
      background: radial-gradient(ellipse, rgba(77,207,255,0.11) 0%, transparent 70%);
      top: 8%; right: -130px;
      animation: orb2 30s ease-in-out infinite alternate;
      animation-delay: -14s;
    }

    .aurora-3 {
      width: 820px; height: 380px;
      background: radial-gradient(ellipse, rgba(5,88,160,0.19) 0%, transparent 70%);
      bottom: -60px; left: 18%;
      animation: orb3 20s ease-in-out infinite alternate;
      animation-delay: -7s;
    }

    @keyframes orb1 {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(50px, 35px) scale(1.07); }
    }
    @keyframes orb2 {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(-38px, 30px) scale(0.93); }
    }
    @keyframes orb3 {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(28px, -24px) scale(1.06); }
    }

    /* ── Dot grid (floats above aurora, below content) ── */
    .dot-grid {
      position: fixed;
      inset: 0;
      background-image: radial-gradient(circle, rgba(160,176,192,0.05) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none;
      z-index: 1;
    }

    /* Ensure content layers above ambient */
    main { position: relative; z-index: 2; }

    /* ── Dashboard wrap breathes (opacity-only = no repaint) */
    .dashboard-wrap::before {
      animation: glow-breathe 12s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

    @keyframes glow-breathe {
      from { opacity: 0.4; }
      to   { opacity: 1;   }
    }

    /* Neon border ring fades in/out via ::after (opacity only) */
    .dashboard-wrap::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 13px;
      border: 1px solid rgba(77, 207, 255, 0.35);
      pointer-events: none;
      opacity: 0;
      animation: border-breathe 12s cubic-bezier(0.45, 0, 0.55, 1) 1s infinite alternate;
    }

    @keyframes border-breathe {
      from { opacity: 0;    }
      to   { opacity: 1;    }
    }

    /* ── Animations ─────────────────────────────────────── */
    @keyframes rise {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.05s both; }
    h1            { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.12s both; }
    .hero-sub     { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.16s both; }
    .hero-flow    { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.20s both; }
    .cta-group    { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.30s both; }
    .hero-icons   { animation: rise 0.5s cubic-bezier(0.16,1,0.3,1) 0.38s both; }
    .dashboard-wrap { animation: rise 0.6s cubic-bezier(0.16,1,0.3,1) 0.18s both; }

    /* ── Scroll reveal (JS adds .in-view; no-JS renders everything visible) ── */
    html.js [data-reveal] {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.65s cubic-bezier(0.16,1,0.3,1),
        transform 0.65s cubic-bezier(0.16,1,0.3,1);
      transition-delay: var(--reveal-delay, 0ms);
    }

    html.js [data-reveal].in-view {
      opacity: 1;
      transform: none;
    }

    /* ── Meter sweep — the signature moment. Bars sweep from 0 to their value in a
       staggered cascade when the demo panel scrolls into view. ── */
    html.js .demo-panel .meter-fill {
      width: 0;
      transition: width 1.1s cubic-bezier(0.22,1,0.36,1);
      transition-delay: var(--meter-delay, 0ms);
    }

    html.js .demo-panel.in-view .meter-fill {
      width: var(--w, 0%);
    }

    /* The blocked row pulses once, after its bar lands. */
    html.js .demo-panel.in-view .meter-fill--hot {
      animation: meter-blocked-pulse 1.4s ease-out 1.5s 1;
    }

    @keyframes meter-blocked-pulse {
      0%, 100% { box-shadow: none; }
      40% { box-shadow: 0 0 12px 1px color-mix(in srgb, var(--fg-ember-hot) 55%, transparent); }
    }

    /* ── Other projects strip ───────────────────────────── */
    .projects {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 2.5rem 4rem;
    }

    .projects-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg-text-muted);
      margin-bottom: 1rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .project-card {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 1rem 1.15rem;
      background: color-mix(in srgb, var(--fg-bg-surface) 80%, transparent);
      border: 1px solid var(--fg-border-subtle);
      border-radius: 10px;
      transition: border-color 0.2s, transform 0.25s cubic-bezier(0.16,1,0.3,1);
    }

    .project-card:hover {
      border-color: var(--fg-border-strong);
      transform: translateY(-2px);
    }

    .project-card:hover .project-name { color: var(--fg-azure-neon); }

    .project-name {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--fg-text-primary);
      transition: color 0.2s;
    }

    .project-name .ext { font-size: 11px; color: var(--fg-text-muted); margin-left: 0.3rem; }

    .project-desc {
      font-size: 12px;
      line-height: 1.5;
      color: var(--fg-text-muted);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        transition-delay: 0ms !important;
      }
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 920px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: 0;
        padding: 3rem 1.5rem 2rem;
      }
      .section { padding: 3.5rem 1.5rem 1.5rem; }
      .proof-grid { grid-template-columns: 1fr; }
      nav { padding: 0 1.25rem; }
      footer { padding: 1.5rem 1.25rem; }
      .projects { padding: 0 1.5rem 3rem; }
    }

    @media (max-width: 640px) {
      .hero { padding: 2.25rem 1.25rem 1.5rem; gap: 2rem; }
      .hero-flow { grid-template-columns: 1fr; }
      .hero-sub { font-size: 0.98rem; }
      .section { padding: 3rem 1.25rem 1.25rem; }
      .section-sub { font-size: 0.92rem; }
      .cta-final { padding: 3.5rem 1.25rem 4rem; }
      .projects-grid { grid-template-columns: 1fr; }
      .projects { padding: 0 1.25rem 2.5rem; }
      .proof-body { font-size: 11px; }
      .demo-table th, .demo-table td { padding-left: 0.9rem; padding-right: 0.9rem; }
      .btn-primary, .btn-secondary { padding: 0.6rem 1.15rem; font-size: 13.5px; }
    }

    @media (max-width: 560px) {
      .nav-links a:not(.nav-signin):not(.nav-keep) { display: none; }
      .nav-logo img { height: 34px; }
      nav { height: 56px; padding: 0 1rem; }
