---
// Five-level quota resolution → tier product assignment.
// No props: the waterfall is fixed by foundrygate-spec §3.2; the tier stage is the
// gateway-centric outcome (#7 direction update, plans/24): the resolved budget picks an
// APIM product, and the product's llm-token-limit policy is what enforces it.
interface Level {
  num: number;
  rule: string;
  result: string;
  resultVariant: 'unlimited' | 'user' | 'group-unlimited' | 'group' | 'system';
}

const levels: Level[] = [
  {
    num: 1,
    rule: 'User.IsUnlimited = true',
    result: 'Unlimited (no monthly cap)',
    resultVariant: 'unlimited',
  },
  {
    num: 2,
    rule: 'User.MonthlyTokenQuota is set',
    result: 'User-specific budget',
    resultVariant: 'user',
  },
  {
    num: 3,
    rule: 'Any group the user belongs to has IsUnlimited = true',
    result: 'Unlimited (via group)',
    resultVariant: 'group-unlimited',
  },
  {
    num: 4,
    rule: 'Max(Group.MonthlyTokenQuota) across all user groups',
    result: 'Highest group budget',
    resultVariant: 'group',
  },
  {
    num: 5,
    rule: 'SystemConfiguration["DefaultMonthlyTokenQuota"]',
    result: 'System-wide default',
    resultVariant: 'system',
  },
];

const ariaLabel =
  'Quota resolution. Five levels, first match wins: 1, User.IsUnlimited gives unlimited; 2, a user-specific ' +
  'MonthlyTokenQuota; 3, any group with IsUnlimited gives unlimited; 4, the highest group MonthlyTokenQuota; ' +
  '5, the SystemConfiguration default. The resolved budget selects a tier product: Standard at 5 million tokens ' +
  'per month and 20 thousand tokens per minute, Power at 20 million and 40 thousand, or Unlimited with no ' +
  'monthly cap and 100 thousand tokens per minute. The developer\'s APIM subscription is created under, or ' +
  'moved to, that product, and the product\'s llm-token-limit policy enforces it in real time: 403 when the ' +
  'monthly quota is exhausted, 429 with Retry-After on the per-minute cap. The subscription state never changes.';
---

<figure class="fgd fgd-qc not-content" role="group" aria-labelledby="fgd-qc-title" aria-describedby="fgd-qc-desc">
  <p id="fgd-qc-title" class="fgd-sr-only">Quota resolution — five levels to a tier product</p>
  <p id="fgd-qc-desc" class="fgd-sr-only">{ariaLabel}</p>
  <ol class="qc-list">
    {levels.map((level) => (
      <li class="qc-row">
        <span class={`qc-badge qc-badge--${level.resultVariant}`}>{level.num}</span>
        <code class="qc-rule fgd-wrap">{level.rule}</code>
        <span class={`qc-result qc-result--${level.resultVariant}`}>{level.result}</span>
      </li>
    ))}
  </ol>
  <p class="qc-note">First match wins — evaluation stops at the first level that resolves.</p>

  <div class="fgd-arrow">
    <span class="fgd-arrow__line"></span>
    <span class="fgd-arrow__label"><strong>resolved budget → tier product</strong> — the control plane maps the value to the tier that carries it</span>
    <span class="fgd-arrow__head"></span>
  </div>

  <div class="fgd-row fgd-row--3">
    <div class="fgd-node fgd-node--azure">
      <div class="fgd-node__title">Standard</div>
      <div class="fgd-node__sub">5M tokens / month<br />20K tokens / minute</div>
    </div>
    <div class="fgd-node fgd-node--azure">
      <div class="fgd-node__title">Power</div>
      <div class="fgd-node__sub">20M tokens / month<br />40K tokens / minute</div>
    </div>
    <div class="fgd-node fgd-node--azure qc-tier--unlimited">
      <div class="fgd-node__title">Unlimited</div>
      <div class="fgd-node__sub">no monthly cap<br />100K tokens / minute</div>
    </div>
  </div>

  <div class="fgd-arrow">
    <span class="fgd-arrow__line"></span>
    <span class="fgd-arrow__label">APIM subscription created under — or moved to — that product</span>
    <span class="fgd-arrow__head"></span>
  </div>

  <div class="qc-enforce">
    <div class="qc-enforce__title">Enforced by the product's <code>llm-token-limit</code> policy, per subscription, in real time</div>
    <div class="qc-enforce__badges">
      <span class="fgd-badge fgd-badge--hot">403 · monthly quota exhausted</span>
      <span class="fgd-badge fgd-badge--ember">429 + Retry-After · per-minute cap</span>
      <span class="fgd-badge fgd-badge--muted">subscription state unchanged</span>
    </div>
  </div>
</figure>

<style>
  .qc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--fg-border-subtle, #1C2E44);
    border-radius: 10px;
    overflow: hidden;
  }

  .qc-row {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background: var(--fg-bg-surface, #0C1420);
    border-bottom: 1px solid var(--fg-border-subtle, #1C2E44);
  }

  .qc-row:last-child { border-bottom: none; }
  .qc-row:nth-child(odd) { background: var(--fg-bg-raised, #101B2A); }

  .qc-badge {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    /* azure-dim is a constant dark chip in both themes (#114) — fixed light text keeps
       it legible instead of pairing with --fg-azure-neon, which is theme-aware and
       gets too dark against this background in light mode. */
    background: var(--fg-azure-dim, #0558A0);
    color: #EAF6FF;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .qc-rule {
    font-family: 'Monaspace Argon', ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.78rem;
    color: var(--fg-text-secondary, #C4D0DC);
    background: none;
    border: none;
    padding: 0;
    min-width: 0;
    white-space: normal; /* rules are sentences, not identifiers — let them wrap */
    overflow-wrap: anywhere;
  }

  .qc-result {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  @media (max-width: 580px) {
    .qc-row {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      row-gap: 0.35rem;
    }
    .qc-result {
      grid-column: 2;
      justify-self: start;
      white-space: normal;
    }
  }

  .qc-result--unlimited,
  .qc-result--group-unlimited {
    color: var(--fg-success, #22C55E);
    background: color-mix(in srgb, var(--fg-success, #22C55E) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg-success, #22C55E) 25%, transparent);
  }

  .qc-result--user {
    color: var(--fg-azure-neon, #4DCFFF);
    background: color-mix(in srgb, var(--fg-azure-neon, #4DCFFF) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg-azure-neon, #4DCFFF) 20%, transparent);
  }

  .qc-result--group {
    color: var(--fg-azure-hover, #3BA3E8);
    background: color-mix(in srgb, var(--fg-azure-hover, #3BA3E8) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg-azure-hover, #3BA3E8) 20%, transparent);
  }

  .qc-result--system {
    color: var(--fg-ember-soft, #FFB347);
    background: color-mix(in srgb, var(--fg-ember, #F58025) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg-ember, #F58025) 25%, transparent);
  }

  .qc-note {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--fg-text-muted, #7E96AD);
    font-style: italic;
  }

  .qc-tier--unlimited { border-color: var(--fg-success, #22C55E); }

  .qc-enforce {
    text-align: center;
    padding: 0.6rem 0.75rem;
    border: 1px dashed color-mix(in srgb, var(--fg-ember, #F58025) 45%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--fg-ember, #F58025) 6%, transparent);
  }

  .qc-enforce__title {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--fg-text-secondary, #C4D0DC);
  }

  .qc-enforce__badges {
    margin-top: 0.4rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.5rem;
  }
</style>
