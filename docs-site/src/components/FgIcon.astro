---
// One inline-SVG icon set for the whole site — landing page, docs components, diagrams.
// Inline (not an icon font, not sprites) so icons inherit currentColor, work in both
// themes, and cost no extra request. 24×24 grid, 1.7 stroke, round caps: the same
// drawing conventions as the icons already used in the architecture diagram.
interface Props {
  name: keyof typeof paths;
  size?: number | string;
  class?: string;
}

const paths = {
  // people & access
  person: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  key: '<circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 8.5-8.5"/><path d="m17 6 2.5 2.5"/><path d="m14 9 2.5 2.5"/>',
  // measuring & limits
  meter: '<path d="M12 20a8 8 0 1 1 8-8"/><path d="m12 12 5-3"/><circle cx="12" cy="12" r="1.4"/>',
  gauge: '<path d="M3 17a9 9 0 1 1 18 0"/><path d="m12 17 4.2-5.6"/>',
  shield: '<path d="M12 2 4 5v6c0 5 3.4 9.2 8 11 4.6-1.8 8-6 8-11V5Z"/><path d="M9 12h6"/><path d="M12 9v6"/>',
  stop: '<circle cx="12" cy="12" r="9"/><path d="M9 9h6v6H9z"/>',
  // requests & approvals
  hand: '<path d="M18 11V6a1.6 1.6 0 0 0-3.2 0"/><path d="M14.8 10V4.6a1.6 1.6 0 0 0-3.2 0V10"/><path d="M11.6 10V5.6a1.6 1.6 0 0 0-3.2 0V13"/><path d="M8.4 12.4 7 11a1.7 1.7 0 0 0-2.4 2.4l3.6 4.9A5 5 0 0 0 12.2 21h1.3a4.5 4.5 0 0 0 4.5-4.5V11"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-5"/>',
  // infrastructure
  laptop: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/><path d="m8 9 2 2-2 2"/><path d="M13 13h3"/>',
  chip: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
  cloud: '<path d="M17.5 19a4 4 0 0 0 .3-8 6 6 0 0 0-11.5 1.4A3.5 3.5 0 0 0 7 19Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  graph: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.6 7.9 10.7 15.6M16.4 7.9 13.3 15.6M8.5 6h7"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z"/><path d="M4 5.5v15"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3"/><path d="M13 15h4"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>',
  sliders: '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="7" cy="18" r="2"/>',
} as const;

const { name, size = 20, class: className = '' } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class={`fg-icon ${className}`}
  width={dim}
  height={dim}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style is:global>
  .fg-icon {
    display: inline-block;
    flex: 0 0 auto;
    vertical-align: middle;
  }
</style>
