---
// System diagram — gateway data plane (request path) + FoundryGate control plane.
// The LAYOUT is hand-maintained (CONVENTIONS.md §Architecture diagrams); the VALUES that
// also exist in infra/ — front-door paths, tier limits, pool priorities, Foundry regions
// and their model deployments, the Functions' schedules — are read from
// src/generated/architecture.json so they cannot drift from main.bicep (#221). The
// fully generated picture is components/ArchitectureDiagram.astro.
// Shared primitives live in src/styles/diagrams.css (.fgd-*).
import arch from '../generated/architecture.json';
import { tokens as fmt, scheduleInline } from '../lib/architecture';

const { infra, code } = arch;
const anthropicPool = infra.pools.find((p) => p.kind === 'pool');
const schedule = (name: string) =>
  code.functions.find((f) => f.name.startsWith(name))?.schedule ?? '';

// The description a screen reader gets must be generated from the SAME model the visible
// nodes read, or the two copies drift apart the first time a tier changes — the exact
// failure this whole generator exists to prevent (#221).
const tierProse = infra.quotaTiers
  .map(
    (t) =>
      `${t.displayName} ${t.monthlyTokenQuota ? `${fmt(t.monthlyTokenQuota)} tokens per month and ` : 'with no monthly cap and '}` +
      `${fmt(t.tpm)} tokens per minute`,
  )
  .join(', ');
const doorProse = infra.frontDoors.map((d) => `/${d.path}`).join(' and ');
const clientProse = infra.frontDoors.map((d) => `${d.client} sends ${d.header}`).join(', ');
const poolProse = (anthropicPool?.members ?? [])
  .map((m) => `priority ${m.priority} ${m.region}`)
  .join(', ');
const modelProse = infra.regions
  .map((r) => `${r.name} (${r.role}) hosting ${r.deployments.map((d) => d.name).join(', ')}`)
  .join('; ');

const ariaLabel =
  `FoundryGate system diagram. Real-time path: developer CLIs (${clientProse}) ` +
  'call the Azure API Management v2 gateway over HTTPS with a personal ' +
  `subscription key. The gateway has ${infra.frontDoors.length} front doors, ${doorProse}, requires the ` +
  `subscription to belong to a tier product (${tierProse}), applies the tier model allowlist and ` +
  'the llm-token-limit policy which returns 403 when the monthly quota is exhausted and 429 with ' +
  'Retry-After when the per-minute cap is hit, then routes with managed identity to backend pools with ' +
  `circuit breakers (Anthropic pool: ${poolProse}; single OpenAI backend) ` +
  `and on to Azure AI Foundry accounts in ${modelProse}. Gateway diagnostics ` +
  'stream LLM logs and token metrics to Log Analytics and Application Insights. Control plane, out of ' +
  'the request path: Entra ID signs users in and is the source of users and groups; the Blazor UI on ' +
  'Azure Static Web Apps calls FoundryGate.Api on Azure Container Apps, which stores state in Azure SQL ' +
  'through EF Core; FoundryGate.Functions run the monthly reset, usage reconciliation (reading ' +
  `ApiManagementGatewayLlmLog from Log Analytics, ${scheduleInline(schedule('UsageSync'))}) and an Entra directory sync ` +
  `${scheduleInline(schedule('EntraSync'))} that reconciles users then groups from Microsoft Graph; ` +
  'Key Vault holds the APIM key-encryption key (no client secrets; Graph is called as each host\'s own managed identity). The API manages APIM ' +
  'subscriptions through the Management API: create under a tier product, regenerate both keys, move tier, delete. ' +
  'FoundryGate.Functions reaches the same Management API for one operation only — moving a subscription to another tier product when a reset resolves a new tier. ' +
  'Legend: solid azure arrows are the real-time enforcement path on the request; dashed grey arrows are telemetry ' +
  'and reconciliation, out of band; dashed amber arrows are control-plane calls for lifecycle and tiers.';
---

<figure class="fgd fgd-system not-content" role="group" aria-labelledby="fgd-system-title" aria-describedby="fgd-system-desc">
  <p id="fgd-system-title" class="fgd-sr-only">FoundryGate system diagram — data plane and control plane</p>
  <p id="fgd-system-desc" class="fgd-sr-only">{ariaLabel}</p>
  <!-- Developers -->
  <div class="fgd-center">
    <div class="fgd-node fgd-node--ext fgd-system__devs">
      <div class="fgd-node__title">Developer workstations</div>
      <div class="fgd-node__sub">
        {infra.frontDoors.map((door, i) => (
          <>{i > 0 ? ' · ' : ''}{door.client} → <code>{door.header}</code></>
        ))}
        · one personal APIM subscription key per developer
      </div>
    </div>
  </div>

  <div class="fgd-arrow">
    <span class="fgd-arrow__label"><strong>HTTPS</strong> — every request carries the developer's key</span>
    <span class="fgd-arrow__line"></span>
    <span class="fgd-arrow__head"></span>
  </div>

  <!-- ── DATA PLANE ─────────────────────────────────────────── -->
  <section class="fgd-plane fgd-plane--data">
    <div class="fgd-plane__label">Data plane <small>Azure API Management v2 · the request path · enforcement happens here</small></div>

    <div class="fgd-row fgd-row--2">
      {infra.frontDoors.map((door) => (
        <div class="fgd-node fgd-node--azure">
          <div class="fgd-node__title">Front door <code>/{door.path}</code></div>
          <div class="fgd-node__sub">{door.label} — {door.client}</div>
        </div>
      ))}
    </div>

    <div class="fgd-arrow">
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__label"><code>fg-require-product</code> — a key with no tier product is refused (403)</span>
      <span class="fgd-arrow__head"></span>
    </div>

    <div class="fgd-row fgd-row--3">
      {infra.quotaTiers.map((tier) => (
        <div class="fgd-node fgd-node--azure">
          <div class="fgd-node__title">{tier.displayName}</div>
          <div class="fgd-node__sub">
            {tier.monthlyTokenQuota ? `${fmt(tier.monthlyTokenQuota)} tokens / month` : 'no monthly cap'}
            <br />{fmt(tier.tpm)} tokens / minute
          </div>
        </div>
      ))}
    </div>

    <div class="fgd-system__policy">
      <div class="fgd-system__policy-title">
        Tier products — one <code>llm-token-limit</code> policy each, counter keyed on the subscription
      </div>
      <div class="fgd-system__policy-body">
        model alias + allowlist →
        <span class="fgd-badge fgd-badge--hot">403 monthly quota exhausted</span>
        <span class="fgd-badge fgd-badge--ember">429 + Retry-After per-minute cap</span>
      </div>
    </div>

    <div class="fgd-arrow">
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__label">gateway <strong>managed identity</strong> → Foundry (no account keys anywhere)</span>
      <span class="fgd-arrow__head"></span>
    </div>

    <div class="fgd-row fgd-row--2">
      <div class="fgd-node fgd-node--azure">
        <div class="fgd-node__title">Anthropic backend pool</div>
        <div class="fgd-node__sub">
          {anthropicPool?.members.map((m, i) => (
            <>{i > 0 ? ' → ' : ''}priority {m.priority} <code>{m.region}</code></>
          ))}<br />
          circuit breaker per backend: 3 × 429/5xx in 30 s trips it, honours Retry-After · retry ×2 across the pool
        </div>
      </div>
      <div class="fgd-node fgd-node--azure">
        <div class="fgd-node__title">OpenAI backend</div>
        <div class="fgd-node__sub">primary region only</div>
      </div>
    </div>

    <div class="fgd-arrow">
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__head"></span>
    </div>

    <div class="fgd-row fgd-row--2">
      {infra.regions.map((region) => (
        <div class="fgd-node fgd-node--azure">
          <div class="fgd-node__title">Azure AI Foundry — {region.name} ({region.role})</div>
          <div class="fgd-node__sub">
            {region.deployments.map((d, i) => (
              <>{i > 0 ? ' · ' : ''}<code>{d.name}</code></>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Telemetry emitted by the gateway (async, not on the request path) -->
    <div class="fgd-arrow fgd-arrow--dashed">
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__label">
        <strong>APIM diagnostic settings</strong> — LLM logs + token metrics, emitted by the gateway asynchronously
      </span>
      <span class="fgd-arrow__head"></span>
    </div>

    <div class="fgd-node fgd-node--muted">
      <div class="fgd-node__title">Log Analytics + Application Insights</div>
      <div class="fgd-node__sub">
        <code>ApiManagementGatewayLlmLog</code> — per-request prompt / completion tokens, joined to the subscription (billing-grade)
        · <code>llm-emit-token-metric</code> — near-real-time dashboards
      </div>
    </div>
  </section>

  <!-- ── BRIDGE: out-of-band links between the planes ───────── -->
  <div class="fgd-system__bridge">
    <div class="fgd-arrow fgd-arrow--app fgd-arrow--up">
      <span class="fgd-arrow__label">
        <strong>APIM Management API</strong> — API: create subscription under a tier product ·
        regenerate both keys · move tier · delete<br />
        Functions: move tier only, when a reset resolves a new one
      </span>
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__head"></span>
    </div>
    <div class="fgd-arrow fgd-arrow--dashed">
      <span class="fgd-arrow__line"></span>
      <span class="fgd-arrow__label">
        <strong>KQL rollup</strong> of <code>ApiManagementGatewayLlmLog</code> → usage reconciliation, every 15 min
      </span>
      <span class="fgd-arrow__head"></span>
    </div>
  </div>

  <!-- ── CONTROL PLANE ──────────────────────────────────────── -->
  <section class="fgd-plane fgd-plane--control">
    <div class="fgd-plane__label">Control plane <small>FoundryGate app · out of the request path · lifecycle, tiers, reporting</small></div>

    <div class="fgd-chain">
      <div class="fgd-node fgd-node--ext">
        <div class="fgd-node__title">Microsoft Entra ID</div>
        <div class="fgd-node__sub">users · groups · sign-in · Graph sync</div>
      </div>
      <div class="fgd-arrow fgd-arrow--app fgd-arrow--h">
        <span class="fgd-arrow__label">JWT</span>
        <span class="fgd-arrow__line"></span>
        <span class="fgd-arrow__head"></span>
      </div>
      <div class="fgd-node fgd-node--app">
        <div class="fgd-node__title">FoundryGate.Web</div>
        <div class="fgd-node__sub">Blazor WASM · Static Web Apps</div>
      </div>
      <div class="fgd-arrow fgd-arrow--app fgd-arrow--h">
        <span class="fgd-arrow__label">REST</span>
        <span class="fgd-arrow__line"></span>
        <span class="fgd-arrow__head"></span>
      </div>
      <div class="fgd-node fgd-node--app">
        <div class="fgd-node__title">FoundryGate.Api</div>
        <div class="fgd-node__sub">ASP.NET Core · Container Apps · managed identity</div>
      </div>
      <div class="fgd-arrow fgd-arrow--app fgd-arrow--h">
        <span class="fgd-arrow__label">EF Core</span>
        <span class="fgd-arrow__line"></span>
        <span class="fgd-arrow__head"></span>
      </div>
      <div class="fgd-node fgd-node--app">
        <div class="fgd-node__title">Azure SQL</div>
        <div class="fgd-node__sub">Users · Groups · QuotaAllocations · Requests · AuditLog</div>
      </div>
    </div>

    <div class="fgd-row fgd-row--2 fgd-system__control-bottom">
      <div class="fgd-node fgd-node--app">
        <div class="fgd-node__title">FoundryGate.Functions</div>
        <div class="fgd-node__sub">
          MonthlyReset — {scheduleInline(schedule('MonthlyQuotaReset'))}, on the configured reset day ·
          UsageSync — {scheduleInline(schedule('UsageSync'))}, reconciliation<br />
          EntraSync — {scheduleInline(schedule('EntraSync'))}: users then groups, from Microsoft Graph<br />
          .NET isolated worker + storage account (runtime, job locks) → Azure SQL via EF Core<br />
          Moves a subscription's tier product when a reset resolves a new one
        </div>
      </div>
      <div class="fgd-node fgd-node--app">
        <div class="fgd-node__title">Azure Key Vault</div>
        <div class="fgd-node__sub">
          <code>fg-apim-key-encryption</code> key · no app secrets (Graph uses the API identity)<br />
          <code>@KeyVault(...)</code> references resolved at startup
        </div>
      </div>
    </div>
  </section>

  <figcaption class="fgd-legend">
    <span class="fgd-legend__item"><span class="fgd-legend__swatch"></span> real-time enforcement — on the request path</span>
    <span class="fgd-legend__item"><span class="fgd-legend__swatch fgd-legend__swatch--dashed"></span> telemetry &amp; reconciliation — out of band</span>
    <span class="fgd-legend__item"><span class="fgd-legend__swatch fgd-legend__swatch--app"></span> control-plane calls — lifecycle &amp; tiers</span>
    <span class="fgd-provenance">
      Layout hand-drawn; the regions, tiers, model deployments, front-door paths and
      Function schedules above are generated from <code>infra/</code> and <code>src/</code>
      at build time.
    </span>
  </figcaption>
</figure>

<style>
  .fgd-system__devs {
    max-width: 34rem;
    width: 100%;
  }

  .fgd-system__policy {
    margin: 0.6rem 0 0;
    padding: 0.5rem 0.75rem;
    border: 1px dashed color-mix(in srgb, var(--fg-azure-neon, #4DCFFF) 45%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--fg-azure, #0078D4) 10%, transparent);
    text-align: center;
  }

  .fgd-system__policy-title {
    color: var(--fg-text-secondary, #C4D0DC);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .fgd-system__policy-body {
    margin-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.72rem;
    color: var(--fg-text-muted, #7E96AD);
  }

  .fgd-system__bridge {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 1.5rem;
    padding: 0.2rem 1.25rem;
  }

  .fgd-system__bridge .fgd-arrow { min-height: 4.2rem; }

  .fgd-system__control-bottom { margin-top: 0.6rem; }


  @media (min-width: 720px) {
    .fgd-system__bridge {
      grid-template-columns: 1fr 1fr;
      padding: 0.2rem 0.9rem;
    }
  }
</style>
