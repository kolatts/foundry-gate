---
// Deploy pipeline — the GitHub Actions flow FoundryGate is built around
// (CONVENTIONS.md §CI/CD, plans/22-cicd-pipelines.md). A merge to main runs exactly one
// workflow, deploy-all.yml: infra → database → api → functions/ui → post-deploy tests →
// summary. It exists on main (#67 / #68–#75) together with the GitHub Environments that gate
// it; none of it has run against Azure yet, which is what the "unvalidated · #105" badge means.
// Keep the stages and status badges in step with .github/workflows/* and docs reference/ci-cd.
interface Stage {
  title: string;
  detail: string;
  status?: string;
  sub?: string[];
  parallel?: string[];
}

const pr: Stage[] = [
  { title: 'Build', detail: 'dotnet build — warnings are errors' },
  { title: 'Pre-deploy tests', detail: 'xUnit · SQLite in-memory · convention tests' },
  { title: 'Format check', detail: 'dotnet format --verify-no-changes' },
  { title: 'Claude review', detail: 'formal review on every PR, reads the test artifacts' },
];

// PR-time stages that only fire on matching paths. None of them reaches an identity with
// subscription access: the image build has no credentials at all, the what-if runs under the
// read-only dev-plan identity, and the UI preview runs under ui-preview, whose custom role is
// assignable only on the dev Static Web App (#155). The preview is the one PR-track stage that
// writes to Azure at all — it publishes a staging slot on that one site.
const prConditional: Stage[] = [
  { title: 'Bicep what-if', detail: 'infra/** — posted as a PR comment · read-only dev-plan identity' },
  { title: 'API image build', detail: 'Dockerfile — docker build + local /health 200, no Azure' },
  { title: 'UI preview', detail: 'FoundryGate.Web/** — dev SWA staging slot · ui-preview identity, one resource' },
  { title: 'Workflow lint', detail: '.github/** — actionlint + shellcheck + script tests' },
];

const main: Stage[] = [
  {
    title: 'Plan',
    detail: 'ungated · no Azure · prints the production approval sequence before the first gate',
  },
  {
    title: 'Infra',
    detail: 'Bicep, subscription scope · what-if first · model deployments create-once',
    status: 'exists · unvalidated · #105',
  },
  {
    title: 'Database',
    detail: 'reusable database workflow',
    status: 'exists · unvalidated · #105',
    sub: [
      'whitelist runner IP',
      'wait 60 s for firewall',
      'probe TCP 1433',
      'deploy dacpac (DacFx, data-loss blocked)',
      'seed reference → seed test (non-prod)',
      'grant identities (contained SQL users)',
      'remove runner firewall rule',
    ],
  },
  {
    title: 'API',
    detail: 'image → ACR → Container Apps · replaces the day-0 placeholder',
    status: 'exists · unvalidated · #105',
  },
  {
    title: 'Functions + UI',
    detail: 'in parallel, after the API',
    status: 'exists · unvalidated · #105',
    parallel: ['Functions → Flex Consumption', 'UI → Static Web Apps'],
  },
  { title: 'Post-deploy tests', detail: 'scaffold smoke test · reporting only until #139', status: 'exists · unvalidated · #105' },
  { title: 'Summary', detail: 'job summary · Environment deploy record', status: 'exists · unvalidated · #105' },
];
---

<figure class="fgd fgd-deploy not-content" role="group" aria-labelledby="fgd-deploy-title" aria-describedby="fgd-deploy-desc">
  <p id="fgd-deploy-title" class="fgd-sr-only">Deploy pipeline — the GitHub Actions flow</p>
  <p id="fgd-deploy-desc" class="fgd-sr-only">
    Two tracks. Track one runs on every pull request today (ci.yml and claude-review.yml): build with warnings as
    errors, predeployment tests, format check, Claude review. Depending on which paths a pull request touches it also
    gets a Bicep what-if posted as a comment, run under a read-only identity; a Docker image build with a local health
    check, which uses no credentials at all; actionlint over the workflow files; and a Static Web Apps preview of the
    UI. The preview is the only thing on the pull request track that writes to Azure, and all it can write is a staging
    slot on the dev Static Web App: its identity holds one custom role assignable on that one resource and nothing
    else. Merging to main is pull-request-only. Track two, on merge, is one workflow, deploy-all.yml: the
    fully automated deploy chain with OIDC and GitHub Environment gates from dev to production. A plan stage that
    touches nothing prints the approval sequence first, then infra, then database
    (whitelist runner IP, wait for firewall propagation, probe port 1433, deploy the dacpac with data-loss blocking,
    seed reference data and test data outside production, grant the API and Functions managed identities their
    contained database users, and remove the runner's firewall rule again), then the API, then Functions and UI in
    parallel, then post-deploy tests, then a summary. Functions and UI wait for the API because on the very first
    deploy the API stage re-runs the infrastructure template to replace the placeholder image. A production run stops
    at the reviewer gate six times, once per pending job, and the plan stage lists them. Every workflow file
    exists on main; badges mark that none has yet run against Azure (live validation is #105).
  </p>

  <section class="fgd-plane fgd-plane--neutral">
    <div class="fgd-plane__label">1 · Pull request <small>runs today — <code>ci.yml</code> + <code>claude-review.yml</code> · cancel-in-progress</small></div>
    <ol class="fgd-deploy__track">
      {pr.map((s, i) => (
        <li class="fgd-deploy__stage">
          <div class="fgd-node fgd-deploy__step">
            <div class="fgd-node__title">{s.title}</div>
            <div class="fgd-node__sub">{s.detail}</div>
          </div>
          {i < pr.length - 1 && (
            <span class="fgd-arrow fgd-arrow--dashed fgd-arrow--h fgd-deploy__link" aria-hidden="true">
              <span class="fgd-arrow__line"></span>
              <span class="fgd-arrow__head"></span>
            </span>
          )}
        </li>
      ))}
    </ol>
    <div class="fgd-deploy__aside">
      <span class="fgd-badge fgd-badge--muted">path-triggered on the same PR</span>
      <ul class="fgd-deploy__conditional">
        {prConditional.map((s) => (
          <li><strong>{s.title}</strong> — {s.detail}</li>
        ))}
      </ul>
    </div>
  </section>

  <div class="fgd-arrow fgd-arrow--dashed">
    <span class="fgd-arrow__line"></span>
    <span class="fgd-arrow__label">
      <strong>merge to main</strong> — PR-only · required check <code>build-test</code> · GitVersion Mainline
    </span>
    <span class="fgd-arrow__head"></span>
  </div>

  <section class="fgd-plane fgd-plane--neutral">
    <div class="fgd-plane__label">2 · Merge to main <small>CONVENTIONS §CI/CD — automatic · OIDC only · Environment gates dev → production · one workflow, <code>deploy-all.yml</code>, runs the whole chain · never cancelled mid-flight</small></div>
    <ol class="fgd-deploy__track">
      {main.map((s, i) => (
        <li class="fgd-deploy__stage">
          <div class="fgd-node fgd-deploy__step">
            <div class="fgd-node__title">{s.title}</div>
            <div class="fgd-node__sub">{s.detail}</div>
            {s.sub && (
              <ol class="fgd-deploy__sub">
                {s.sub.map((t) => <li>{t}</li>)}
              </ol>
            )}
            {s.parallel && (
              <ul class="fgd-deploy__parallel">
                {s.parallel.map((t) => <li>{t}</li>)}
              </ul>
            )}
            {s.status && <div class="fgd-deploy__status"><span class="fgd-badge fgd-badge--muted">{s.status}</span></div>}
          </div>
          {i < main.length - 1 && (
            <span class="fgd-arrow fgd-arrow--dashed fgd-arrow--h fgd-deploy__link" aria-hidden="true">
              <span class="fgd-arrow__line"></span>
              <span class="fgd-arrow__head"></span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <figcaption class="fgd-legend">
    <span class="fgd-legend__item"><span class="fgd-badge fgd-badge--muted">exists · unvalidated · #105</span> workflow file and Environment gate are on <code>main</code>; not yet run against Azure (owner OIDC setup #109, live validation #105)</span>
  </figcaption>
</figure>

<style>
  .fgd-deploy__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fgd-deploy__stage {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
  }

  .fgd-deploy__step {
    flex: 1 1 auto;
    text-align: left;
  }

  .fgd-deploy__link { flex: 0 0 auto; }

  .fgd-deploy__sub {
    list-style: decimal;
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.7rem;
    color: var(--fg-text-secondary, #C4D0DC);
    line-height: 1.45;
  }

  .fgd-deploy__sub li::marker {
    color: var(--fg-text-muted, #7E96AD);
    font-family: 'Monaspace Argon', ui-monospace, monospace;
    font-size: 0.68rem;
  }

  .fgd-deploy__parallel {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: var(--fg-text-secondary, #C4D0DC);
  }

  .fgd-deploy__parallel li {
    border: 1px solid var(--fg-border-subtle, #1C2E44);
    border-left: 3px solid var(--fg-border-strong, #2A4260);
    border-radius: 4px;
    padding: 0.2rem 0.45rem;
    background: var(--fg-bg-surface, #0C1420);
  }

  .fgd-deploy__status {
    margin-top: 0.45rem;
    text-align: left;
  }

  /* Status badges may wrap inside a narrow stage; identifiers elsewhere stay nowrap. */
  .fgd-deploy__status .fgd-badge {
    white-space: normal;
    line-height: 1.3;
  }

  .fgd-deploy__aside {
    margin-top: 0.6rem;
    padding: 0.45rem 0.7rem;
    border: 1px dashed var(--fg-border-strong, #2A4260);
    border-radius: 8px;
    font-size: 0.72rem;
    color: var(--fg-text-muted, #7E96AD);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }

  .fgd-deploy__aside strong { color: var(--fg-text-secondary, #C4D0DC); }

  .fgd-deploy__conditional {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1 1 16rem;
  }

  @media (min-width: 720px) {
    .fgd-deploy__track {
      flex-direction: row;
      align-items: stretch;
    }
    /* Content-driven sizing: each stage starts from its own text width and all shrink
       together, so a one-line stage is never starved by a stage with sub-steps. */
    .fgd-deploy__stage {
      flex: 1 1 auto;
      flex-direction: row;
      align-items: center;
    }
    .fgd-deploy__step {
      height: 100%;
      min-width: 6.5rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .fgd-deploy__step .fgd-node__title { font-size: 0.76rem; }
    .fgd-deploy__step .fgd-node__sub { font-size: 0.7rem; }
    .fgd-deploy__link {
      min-width: 1.4rem;
      padding: 0 0.1rem;
      align-self: center;
    }
  }
</style>
