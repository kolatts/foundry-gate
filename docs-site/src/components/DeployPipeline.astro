---
// Deploy pipeline — the fully automated GitHub Actions flow (CONVENTIONS.md §CI/CD).
// No props: hand-maintained picture of the designed pipeline; keep in step with
// .github/workflows/* and plans/22-cicd-pipelines.md.
interface Stage {
  title: string;
  detail: string;
  sub?: string[];
  parallel?: string[];
}

const pr: Stage[] = [
  { title: 'Build', detail: 'dotnet build — warnings are errors' },
  { title: 'Pre-deploy tests', detail: 'xUnit · SQLite in-memory · convention tests' },
  { title: 'Format check', detail: 'dotnet format --verify-no-changes' },
  { title: 'Claude review', detail: 'formal review on every PR, reads the test artifacts' },
  { title: 'Bicep what-if', detail: 'posted as a PR comment when infra/** changes' },
];

const main: Stage[] = [
  {
    title: 'Infra',
    detail: 'Bicep, sub-scope · model deploys are create-once',
  },
  {
    title: 'Database',
    detail: 'reusable database workflow',
    sub: [
      'whitelist runner IP',
      'wait 60 s for firewall',
      'probe TCP 1433',
      'deploy dacpac (DacFx, data-loss blocked)',
      'seed reference → seed test (non-prod)',
    ],
  },
  {
    title: 'App deploys',
    detail: 'in parallel',
    parallel: ['Api → Container Apps', 'Functions → Flex Consumption', 'UI → Static Web Apps'],
  },
  { title: 'Post-deploy tests', detail: 'Playwright · live site · desktop + mobile' },
  { title: 'Summary', detail: 'job summary · Environment deploy record' },
];

const ariaLabel =
  'Deploy pipeline. Stage one, every pull request: build with warnings as errors, predeployment tests, ' +
  'format check, Claude review, and a Bicep what-if posted as a PR comment. Merge to main is PR-only. ' +
  'Stage two, on merge, fully automated with OIDC and GitHub Environment gates from dev to production: ' +
  'infra deploy, then database deploy (whitelist runner IP, wait for firewall propagation, probe port 1433, ' +
  'deploy the dacpac with data-loss blocking, seed reference data and test data outside production), then ' +
  'API, Functions and UI deploys in parallel, then postdeployment Playwright tests, then a summary.';
---

<figure class="fgd fgd-deploy not-content" role="img" aria-label={ariaLabel}>
  <section class="fgd-plane fgd-plane--data">
    <div class="fgd-plane__label">1 · Pull request <small>ci.yml on every PR · cancel-in-progress</small></div>
    <ol class="fgd-deploy__track">
      {pr.map((s, i) => (
        <li class="fgd-deploy__stage">
          <div class="fgd-node fgd-node--azure fgd-deploy__step">
            <div class="fgd-node__title">{s.title}</div>
            <div class="fgd-node__sub">{s.detail}</div>
          </div>
          {i < pr.length - 1 && (
            <span class="fgd-arrow fgd-arrow--h fgd-deploy__link" aria-hidden="true">
              <span class="fgd-arrow__line"></span>
              <span class="fgd-arrow__head"></span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <div class="fgd-arrow fgd-arrow--app">
    <span class="fgd-arrow__line"></span>
    <span class="fgd-arrow__label">
      <strong>merge to main</strong> — PR-only · required check <code>build-test</code> · GitVersion Mainline
    </span>
    <span class="fgd-arrow__head"></span>
  </div>

  <section class="fgd-plane fgd-plane--control">
    <div class="fgd-plane__label">2 · Merge to main <small>automatic · OIDC only · Environment gates dev → production · concurrency lock</small></div>
    <ol class="fgd-deploy__track">
      {main.map((s, i) => (
        <li class:list={['fgd-deploy__stage', { 'fgd-deploy__stage--wide': !!(s.sub || s.parallel) }]}>
          <div class="fgd-node fgd-node--app fgd-deploy__step">
            <div class="fgd-node__title">{s.title}</div>
            <div class="fgd-node__sub">{s.detail}</div>
            {s.sub && (
              <ol class="fgd-deploy__sub">
                {s.sub.map((t) => <li>{t}</li>)}
              </ol>
            )}
            {s.parallel && (
              <ul class="fgd-deploy__parallel">
                {s.parallel.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </div>
          {i < main.length - 1 && (
            <span class="fgd-arrow fgd-arrow--app fgd-arrow--h fgd-deploy__link" aria-hidden="true">
              <span class="fgd-arrow__line"></span>
              <span class="fgd-arrow__head"></span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <figcaption class="fgd-legend">
    <span class="fgd-legend__item"><span class="fgd-legend__swatch"></span> gates a PR</span>
    <span class="fgd-legend__item"><span class="fgd-legend__swatch fgd-legend__swatch--app"></span> mutates an environment (GitHub Environment approval applies)</span>
  </figcaption>
</figure>

<style>
  .fgd-deploy__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fgd-deploy__stage {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: 1 1 0;
    min-width: 0;
  }

  .fgd-deploy__step {
    flex: 1 1 auto;
    text-align: left;
  }

  .fgd-deploy__link {
    flex: 0 0 auto;
  }

  .fgd-deploy__sub {
    list-style: decimal;
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.7rem;
    color: var(--fg-text-secondary, #C4D0DC);
    line-height: 1.45;
  }

  .fgd-deploy__sub li::marker {
    color: var(--fg-ember-soft, #FFB347);
    font-family: 'Monaspace Argon', ui-monospace, monospace;
    font-size: 0.68rem;
  }

  .fgd-deploy__parallel {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: var(--fg-text-secondary, #C4D0DC);
  }

  .fgd-deploy__parallel li {
    border: 1px solid var(--fg-border-subtle, #1C2E44);
    border-left: 3px solid var(--fg-ember-soft, #FFB347);
    border-radius: 4px;
    padding: 0.2rem 0.45rem;
    background: var(--fg-bg-surface, #0C1420);
  }

  @media (min-width: 720px) {
    .fgd-deploy__track {
      flex-direction: row;
      align-items: stretch;
    }
    .fgd-deploy__stage {
      flex-direction: row;
      align-items: center;
    }
    /* Stages with sub-steps / parallel lists need more room than one-liners. */
    .fgd-deploy__stage--wide { flex-grow: 1.45; }
    .fgd-deploy__step {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .fgd-deploy__link {
      min-width: 1.4rem;
      padding: 0 0.1rem;
      align-self: center;
    }
    /* Five stages share ~680px of content width: tighten type so words stay whole. */
    .fgd-deploy__step .fgd-node__title { font-size: 0.76rem; }
    .fgd-deploy__step .fgd-node__sub { font-size: 0.7rem; }
  }
</style>
